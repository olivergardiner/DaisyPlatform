  30:effects/choruseffect.cpp ****     switch (shape) {
  31:effects/choruseffect.cpp ****         case 1: {
  32:effects/choruseffect.cpp ****             // Triangle [-1, 1]
  33:effects/choruseffect.cpp ****             float t = phase * 2.0f;
  34:effects/choruseffect.cpp ****             return (t < 1.0f) ? (-1.0f + 2.0f * t) : (3.0f - 2.0f * t);
  35:effects/choruseffect.cpp ****         }
  36:effects/choruseffect.cpp ****         case 2:
  37:effects/choruseffect.cpp ****             // Rising saw [-1, 1]
  38:effects/choruseffect.cpp ****             return -1.0f + 2.0f * phase;
  39:effects/choruseffect.cpp ****         case 3:
  40:effects/choruseffect.cpp ****             // Square [-1, 1]
  41:effects/choruseffect.cpp ****             return (phase < 0.5f) ? 1.0f : -1.0f;
  42:effects/choruseffect.cpp ****         case 0:
  43:effects/choruseffect.cpp ****         default:
  44:effects/choruseffect.cpp ****             // Sine [-1, 1]
  45:effects/choruseffect.cpp ****             return std::sinf(2.0f * kPi * phase);
  46:effects/choruseffect.cpp ****     }
  47:effects/choruseffect.cpp **** }
  48:effects/choruseffect.cpp **** 
  49:effects/choruseffect.cpp **** static inline float CubicInterpolate(float y0, float y1, float y2, float y3, float t) {
  50:effects/choruseffect.cpp ****     float a0 = y3 - y2 - y0 + y1;
  51:effects/choruseffect.cpp ****     float a1 = y0 - y1 - a0;
  52:effects/choruseffect.cpp ****     float a2 = y2 - y0;
  53:effects/choruseffect.cpp ****     float a3 = y1;
  54:effects/choruseffect.cpp ****     return ((a0 * t + a1) * t + a2) * t + a3;
  55:effects/choruseffect.cpp **** }
  56:effects/choruseffect.cpp **** 
  57:effects/choruseffect.cpp **** static inline float ReadDelayInterpolated(const float* buffer, int size, float readPos) {
  58:effects/choruseffect.cpp ****     while (readPos < 0.0f) {
  59:effects/choruseffect.cpp ****         readPos += static_cast<float>(size);
  60:effects/choruseffect.cpp ****     }
  61:effects/choruseffect.cpp ****     while (readPos >= static_cast<float>(size)) {
  62:effects/choruseffect.cpp ****         readPos -= static_cast<float>(size);
  63:effects/choruseffect.cpp ****     }
  64:effects/choruseffect.cpp **** 
  65:effects/choruseffect.cpp ****     int x1 = static_cast<int>(readPos);
  66:effects/choruseffect.cpp ****     float frac = readPos - static_cast<float>(x1);
  67:effects/choruseffect.cpp **** 
  68:effects/choruseffect.cpp ****     int x0 = (x1 - 1 + size) % size;
  69:effects/choruseffect.cpp ****     int x2 = (x1 + 1) % size;
  70:effects/choruseffect.cpp ****     int x3 = (x1 + 2) % size;
  71:effects/choruseffect.cpp **** 
  72:effects/choruseffect.cpp ****     return CubicInterpolate(buffer[x0], buffer[x1], buffer[x2], buffer[x3], frac);
  73:effects/choruseffect.cpp **** }
