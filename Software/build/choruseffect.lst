  13:effects/choruseffect.cpp **** 
  14:effects/choruseffect.cpp **** static inline float Clamp01(float x) {
  15:effects/choruseffect.cpp ****     return std::max(0.0f, std::min(x, 1.0f));
  16:effects/choruseffect.cpp **** }
  17:effects/choruseffect.cpp **** 
  18:effects/choruseffect.cpp **** static inline float WrapPhase(float phase) {
  19:effects/choruseffect.cpp ****     while (phase >= 1.0f) {
  20:effects/choruseffect.cpp ****         phase -= 1.0f;
  21:effects/choruseffect.cpp ****     }
  22:effects/choruseffect.cpp ****     while (phase < 0.0f) {
  23:effects/choruseffect.cpp ****         phase += 1.0f;
  24:effects/choruseffect.cpp ****     }
  25:effects/choruseffect.cpp ****     return phase;
  26:effects/choruseffect.cpp **** }
  27:effects/choruseffect.cpp **** 
  28:effects/choruseffect.cpp **** static inline float LfoValue(float phase, int shape) {
