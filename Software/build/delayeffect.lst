  88:effects/delayeffect.cpp **** void DelayEffect::Init(float sampleRate) {
  89:effects/delayeffect.cpp ****     sampleRate_ = sampleRate;
  90:effects/delayeffect.cpp **** 
  91:effects/delayeffect.cpp ****     // Claim delay buffers once at startup (before audio thread starts).
  92:effects/delayeffect.cpp ****     TryAllocateDelayLines();
  93:effects/delayeffect.cpp ****     
  94:effects/delayeffect.cpp ****     // Initialize metronome bass drum
  95:effects/delayeffect.cpp ****     metronomeDrum_.Init(sampleRate);
  96:effects/delayeffect.cpp ****     metronomeDrum_.SetFreq(60.0f);  // Low bass frequency
  97:effects/delayeffect.cpp ****     metronomeDrum_.SetTone(0.5f);
  98:effects/delayeffect.cpp ****     metronomeDrum_.SetDecay(0.3f);
  99:effects/delayeffect.cpp ****     metronomeDrum_.SetAccent(0.8f);
 100:effects/delayeffect.cpp ****     samplesUntilNextBeat_ = 0.0f;
 101:effects/delayeffect.cpp ****     
 102:effects/delayeffect.cpp ****     // Add parameters: Mix, Feedback, Subdivision, Time, TempoToggle
 103:effects/delayeffect.cpp ****     AddParameter(new PotentiometerParameter("K1 Mix", 0.0f, 1.0f, 0.50f, PotCurve::LIN, KNOB_1_IDX)
 104:effects/delayeffect.cpp ****     parameters_.back()->SetDisplayType(DisplayType::SCALED);
 105:effects/delayeffect.cpp ****     parameters_.back()->SetScaleFactor(100.0f); // Display mix as percentage
 106:effects/delayeffect.cpp ****     
 107:effects/delayeffect.cpp ****     AddParameter(new PotentiometerParameter("K2 Feedback", 0.0f, 0.95f, 0.5f, PotCurve::LIN, KNOB_2
 108:effects/delayeffect.cpp ****     parameters_.back()->SetDisplayType(DisplayType::SCALED);
 109:effects/delayeffect.cpp ****     parameters_.back()->SetScaleFactor(100.0f); // Display feedback as percentage
 110:effects/delayeffect.cpp ****     
 111:effects/delayeffect.cpp ****     AddParameter(new PotentiometerParameter("K3 Subdivision", 0.0f, 6.0f, 3.0f, PotCurve::LIN, KNOB
 112:effects/delayeffect.cpp ****     parameters_.back()->SetDisplayType(DisplayType::DISCRETE);
 113:effects/delayeffect.cpp ****     parameters_.back()->SetDiscreteValues(subDivisions, 7);
 114:effects/delayeffect.cpp ****     subdivisionParamIndex_ = 2;  // Track subdivision parameter index
 115:effects/delayeffect.cpp ****     
 116:effects/delayeffect.cpp ****     // TimeParameter with milliseconds range (10-2000 ms), 1ms step in time mode, 0.5 BPM in tempo 
 117:effects/delayeffect.cpp ****     AddParameter(new TimeParameter("E1 Time", 10.0f, 2000.0f, 500.0f, 1.0f, ENCODER_1_IDX, "E1 Temp
 118:effects/delayeffect.cpp ****     timeParamIndex_ = 3;  // Track time parameter index
 119:effects/delayeffect.cpp ****     
 120:effects/delayeffect.cpp ****     AddParameter(new ToggleParameter("Tempo Mode", false, ENCODER_1_BUTTON_IDX, "On", "Off", -1)); 
 121:effects/delayeffect.cpp ****     
 122:effects/delayeffect.cpp ****     // Set default delay parameters
 123:effects/delayeffect.cpp ****     Update();
 124:effects/delayeffect.cpp **** }
