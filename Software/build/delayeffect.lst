 126:effects/delayeffect.cpp **** void DelayEffect::Process(float* in, float* out, size_t size) {
 127:effects/delayeffect.cpp ****     if (!enabled_ || !delayBuffersAllocated_ || !delayL_) {
 128:effects/delayeffect.cpp ****         // Bypass - pass through dry signal
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccsZeAB2.s 			page 7


 129:effects/delayeffect.cpp ****         for (size_t i = 0; i < size; i++) {
 130:effects/delayeffect.cpp ****             out[i] = in[i];
 131:effects/delayeffect.cpp ****         }
 132:effects/delayeffect.cpp ****         return;
 133:effects/delayeffect.cpp ****     }
 134:effects/delayeffect.cpp ****     
 135:effects/delayeffect.cpp ****     // Get parameters
 136:effects/delayeffect.cpp ****     float mix = parameters_.size() > 0 ? parameters_[0]->GetValue() : 0.5f;
 137:effects/delayeffect.cpp ****     float feedback = parameters_.size() > 1 ? parameters_[1]->GetValue() : 0.5f;
 138:effects/delayeffect.cpp ****     
 139:effects/delayeffect.cpp ****     // Process with wet/dry blend
 140:effects/delayeffect.cpp ****     for (size_t i = 0; i < size; i++) {
 141:effects/delayeffect.cpp ****         float delayed = delayL_->Read();
 142:effects/delayeffect.cpp ****         delayL_->Write(in[i] + delayed * feedback);
 143:effects/delayeffect.cpp ****         
 144:effects/delayeffect.cpp ****         out[i] = wetOnly_ ? (delayed * mix) : (in[i] + delayed * mix);
 145:effects/delayeffect.cpp ****     }
 146:effects/delayeffect.cpp **** }
 147:effects/delayeffect.cpp **** 
 148:effects/delayeffect.cpp **** void DelayEffect::ProcessStereo(float* inL, float* inR, float* outL, float* outR, size_t size) {
 149:effects/delayeffect.cpp ****     if (!enabled_ || !delayBuffersAllocated_ || !delayL_ || !delayR_) {
 150:effects/delayeffect.cpp ****         // Bypass - pass through dry signal
 151:effects/delayeffect.cpp ****         for (size_t i = 0; i < size; i++) {
 152:effects/delayeffect.cpp ****             outL[i] = inL[i];
 153:effects/delayeffect.cpp ****             outR[i] = inR[i];
 154:effects/delayeffect.cpp ****         }
 155:effects/delayeffect.cpp ****         return;
 156:effects/delayeffect.cpp ****     }
 157:effects/delayeffect.cpp ****     
 158:effects/delayeffect.cpp ****     // Get parameters
 159:effects/delayeffect.cpp ****     float mix = parameters_.size() > 0 ? parameters_[0]->GetValue() : 0.5f;
 160:effects/delayeffect.cpp ****     float feedback = parameters_.size() > 1 ? parameters_[1]->GetValue() : 0.5f;
 161:effects/delayeffect.cpp ****     
 162:effects/delayeffect.cpp ****     // Process stereo signal with independent delays
 163:effects/delayeffect.cpp ****     for (size_t i = 0; i < size; i++) {
 164:effects/delayeffect.cpp ****         float delayedL = delayL_->Read();
 165:effects/delayeffect.cpp ****         float delayedR = delayR_->Read();
 166:effects/delayeffect.cpp ****         
 167:effects/delayeffect.cpp ****         delayL_->Write(inL[i] + delayedL * feedback);
 168:effects/delayeffect.cpp ****         delayR_->Write(inR[i] + delayedR * feedback);
 169:effects/delayeffect.cpp ****         
 170:effects/delayeffect.cpp ****         // Mix in metronome
 171:effects/delayeffect.cpp ****         float metronome = ProcessMetronome();
 172:effects/delayeffect.cpp ****         
 173:effects/delayeffect.cpp ****         outL[i] = wetOnly_ ? (delayedL * mix) : (inL[i] + delayedL * mix);
 174:effects/delayeffect.cpp ****         outR[i] = wetOnly_ ? (delayedR * mix) : (inR[i] + delayedR * mix);
 175:effects/delayeffect.cpp ****         
 176:effects/delayeffect.cpp ****         // Add metronome to both channels
 177:effects/delayeffect.cpp ****         outL[i] += metronome;
 178:effects/delayeffect.cpp ****         outR[i] += metronome;
 179:effects/delayeffect.cpp ****     }
 180:effects/delayeffect.cpp **** }
