  16:effects/delayeffect.cpp **** 
  17:effects/delayeffect.cpp **** // Allocate a delay line pair from the pool
  18:effects/delayeffect.cpp **** static int AllocateDelayInstance() {
  19:effects/delayeffect.cpp ****     for (size_t i = 0; i < MAX_DELAY_INSTANCES; i++) {
  20:effects/delayeffect.cpp ****         if (!delayPoolUsed_[i]) {
  21:effects/delayeffect.cpp ****             delayPoolUsed_[i] = true;
  22:effects/delayeffect.cpp ****             return static_cast<int>(i);
  23:effects/delayeffect.cpp ****         }
  24:effects/delayeffect.cpp ****     }
  25:effects/delayeffect.cpp ****     return -1; // Pool exhausted
  26:effects/delayeffect.cpp **** }
  27:effects/delayeffect.cpp **** 
