  12:effects/delayeffect.cpp **** // Static pool of delay lines in SDRAM (supports up to MAX_DELAY_INSTANCES)
  13:effects/delayeffect.cpp **** static DelayLine<float, MAX_DELAY> DSY_SDRAM_BSS delayPoolL_[MAX_DELAY_INSTANCES];
