 210:effects/autowahv2effect.cpp **** float AutowahV2Effect::ComputeCompensatedResonance(float resonance, float cutoffHz) const {
 211:effects/autowahv2effect.cpp ****     float normalized = ClampValue(cutoffHz / kMaxCutoffHz, 0.0f, 1.0f);
 212:effects/autowahv2effect.cpp **** 
 213:effects/autowahv2effect.cpp ****     // Keep perceived Q more consistent across the sweep range.
 214:effects/autowahv2effect.cpp ****     float compensation = 0.75f + 0.5f * sqrtf(normalized);
 215:effects/autowahv2effect.cpp ****     return ClampValue(resonance * compensation, 0.0f, 1.0f);
 216:effects/autowahv2effect.cpp **** }
