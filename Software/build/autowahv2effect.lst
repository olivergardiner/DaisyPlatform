 182:effects/autowahv2effect.cpp **** float AutowahV2Effect::ComputeTargetCutoffHz(float baseFreq, float sensitivityHz, float envelope, b
 183:effects/autowahv2effect.cpp ****     float endFreq = baseFreq + sensitivityHz;
 184:effects/autowahv2effect.cpp ****     float minFreq = sensitivityHz < 0.0f ? kDownSweepFloorHz : kMinCutoffHz;
 185:effects/autowahv2effect.cpp **** 
 186:effects/autowahv2effect.cpp ****     float f0 = ClampValue(baseFreq, minFreq, kMaxCutoffHz);
 187:effects/autowahv2effect.cpp ****     float f1 = ClampValue(endFreq, minFreq, kMaxCutoffHz);
 188:effects/autowahv2effect.cpp **** 
 189:effects/autowahv2effect.cpp ****     if (fabsf(f1 - f0) < 0.001f) {
 190:effects/autowahv2effect.cpp ****         return f0;
 191:effects/autowahv2effect.cpp ****     }
 192:effects/autowahv2effect.cpp **** 
 193:effects/autowahv2effect.cpp ****     float clampedEnv = ClampValue(envelope, 0.0f, 1.0f);
 194:effects/autowahv2effect.cpp **** 
 195:effects/autowahv2effect.cpp ****     if (!useLogCurve) {
 196:effects/autowahv2effect.cpp ****         float targetLinear = f0 + ((f1 - f0) * clampedEnv);
 197:effects/autowahv2effect.cpp ****         return ClampValue(targetLinear, minFreq, kMaxCutoffHz);
 198:effects/autowahv2effect.cpp ****     }
 199:effects/autowahv2effect.cpp **** 
 200:effects/autowahv2effect.cpp ****     float ratio = f1 / f0;
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccfWwZfG.s 			page 5


 201:effects/autowahv2effect.cpp ****     if (ratio <= 0.0f) {
 202:effects/autowahv2effect.cpp ****         return f0;
 203:effects/autowahv2effect.cpp ****     }
 204:effects/autowahv2effect.cpp **** 
 205:effects/autowahv2effect.cpp ****     // Log-frequency sweep sounds more natural than linear-Hz mapping.
 206:effects/autowahv2effect.cpp ****     float target = f0 * powf(ratio, clampedEnv);
 207:effects/autowahv2effect.cpp ****     return ClampValue(target, minFreq, kMaxCutoffHz);
 208:effects/autowahv2effect.cpp **** }
