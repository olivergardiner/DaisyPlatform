  50:parameters/timeparameter.cpp **** 
  51:parameters/timeparameter.cpp **** void TimeParameter::Increment(int steps) {
  52:parameters/timeparameter.cpp ****     if (displayMode_ == TimeDisplayMode::TEMPO_BPM) {
  53:parameters/timeparameter.cpp ****         // In tempo mode, increment BPM (which means decrement ms)
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\cc7K8AR5.s 			page 4


  54:parameters/timeparameter.cpp ****         // So we swap the operation: decrement by BPM_STEP_SIZE * steps
  55:parameters/timeparameter.cpp ****         float currentBpm = GetValueAsBPM();
  56:parameters/timeparameter.cpp ****         float newBpm = currentBpm - (BPM_STEP_SIZE * steps);
  57:parameters/timeparameter.cpp ****         
  58:parameters/timeparameter.cpp ****         // Clamp BPM to valid range (30-200 BPM corresponds to 2000-300 ms)
  59:parameters/timeparameter.cpp ****         newBpm = clamp(newBpm, 30.0f, 200.0f);
  60:parameters/timeparameter.cpp ****         
  61:parameters/timeparameter.cpp ****         // Convert back to milliseconds
  62:parameters/timeparameter.cpp ****         float newMs = 60000.0f / newBpm;
  63:parameters/timeparameter.cpp ****         SetValue(newMs);
  64:parameters/timeparameter.cpp ****     } else {
  65:parameters/timeparameter.cpp ****         // In time mode, use base class stepping
  66:parameters/timeparameter.cpp ****         EncoderParameter::Increment(steps);
  67:parameters/timeparameter.cpp ****     }
  68:parameters/timeparameter.cpp **** }
  69:parameters/timeparameter.cpp **** 
  70:parameters/timeparameter.cpp **** void TimeParameter::Decrement(int steps) {
  71:parameters/timeparameter.cpp ****     if (displayMode_ == TimeDisplayMode::TEMPO_BPM) {
  72:parameters/timeparameter.cpp ****         // In tempo mode, decrement BPM (which means increment ms)
  73:parameters/timeparameter.cpp ****         // So we swap the operation: increment by BPM_STEP_SIZE * steps
  74:parameters/timeparameter.cpp ****         float currentBpm = GetValueAsBPM();
  75:parameters/timeparameter.cpp ****         float newBpm = currentBpm + (BPM_STEP_SIZE * steps);
  76:parameters/timeparameter.cpp ****         
  77:parameters/timeparameter.cpp ****         // Clamp BPM to valid range (30-200 BPM corresponds to 2000-300 ms)
  78:parameters/timeparameter.cpp ****         newBpm = clamp(newBpm, 30.0f, 200.0f);
  79:parameters/timeparameter.cpp ****         
  80:parameters/timeparameter.cpp ****         // Convert back to milliseconds
  81:parameters/timeparameter.cpp ****         float newMs = 60000.0f / newBpm;
  82:parameters/timeparameter.cpp ****         SetValue(newMs);
  83:parameters/timeparameter.cpp ****     } else {
  84:parameters/timeparameter.cpp ****         // In time mode, use base class stepping
  85:parameters/timeparameter.cpp ****         EncoderParameter::Decrement(steps);
  86:parameters/timeparameter.cpp ****     }
  87:parameters/timeparameter.cpp **** }
