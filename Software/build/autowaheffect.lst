 104:effects/autowaheffect.cpp **** void AutowahEffect::ProcessStereo(float* inL, float* inR, float* outL, float* outR, size_t size) {
 105:effects/autowaheffect.cpp ****     if (!enabled_) {
 106:effects/autowaheffect.cpp ****         detectorInput_ = 0.0f;
 107:effects/autowaheffect.cpp ****         // Bypass - pass through dry signal
 108:effects/autowaheffect.cpp ****         for (size_t i = 0; i < size; i++) {
 109:effects/autowaheffect.cpp ****             outL[i] = inL[i];
 110:effects/autowaheffect.cpp ****             outR[i] = inR[i];
 111:effects/autowaheffect.cpp ****         }
 112:effects/autowaheffect.cpp ****         return;
 113:effects/autowaheffect.cpp ****     }
 114:effects/autowaheffect.cpp ****     
 115:effects/autowaheffect.cpp ****     // Get mix parameter
 116:effects/autowaheffect.cpp ****     float mix = parameters_.size() > 0 ? parameters_[0]->GetValue() : 0.5f;
 117:effects/autowaheffect.cpp ****     
 118:effects/autowaheffect.cpp ****     // Get parameters
 119:effects/autowaheffect.cpp ****     float baseFreq = parameters_.size() >= 6 ? parameters_[2]->GetValue() : 1000.0f;
 120:effects/autowaheffect.cpp ****     float attackTime = parameters_.size() >= 6 ? parameters_[3]->GetValue() : 0.1f;
 121:effects/autowaheffect.cpp ****     float releaseTime = parameters_.size() >= 6 ? parameters_[4]->GetValue() : 0.001f;
 122:effects/autowaheffect.cpp ****     float sensitivityHz = parameters_.size() >= 6 ? parameters_[5]->GetValue() : 1600.0f;
 123:effects/autowaheffect.cpp **** 
 124:effects/autowaheffect.cpp ****     float attackSec = std::max(0.0001f, attackTime);
 125:effects/autowaheffect.cpp ****     float releaseSec = std::max(0.0001f, releaseTime);
 126:effects/autowaheffect.cpp ****     float detectorGain = DetectorGainFromAttack(attackSec);
 127:effects/autowaheffect.cpp ****     float attackAlpha = 1.0f - expf(-1.0f / (sampleRate_ * attackSec));
 128:effects/autowaheffect.cpp ****     float releaseAlpha = 1.0f - expf(-1.0f / (sampleRate_ * releaseSec));
 129:effects/autowaheffect.cpp **** 
 130:effects/autowaheffect.cpp ****     // Process stereo signal with independent filters
 131:effects/autowaheffect.cpp ****     for (size_t i = 0; i < size; i++) {
 132:effects/autowaheffect.cpp ****         // Compute average envelope of both inputs
 133:effects/autowaheffect.cpp ****         float avgInput = (std::abs(inL[i]) + std::abs(inR[i])) * 0.5f;
 134:effects/autowaheffect.cpp ****         float detectorInput = std::min(avgInput * detectorGain, 1.0f);
 135:effects/autowaheffect.cpp ****         detectorInput_ = detectorInput;
 136:effects/autowaheffect.cpp ****         
 137:effects/autowaheffect.cpp ****         // Envelope follower with independent attack/release time constants.
 138:effects/autowaheffect.cpp ****         if (detectorInput > envelope_) {
 139:effects/autowaheffect.cpp ****             envelope_ += attackAlpha * (detectorInput - envelope_);
 140:effects/autowaheffect.cpp ****         } else {
 141:effects/autowaheffect.cpp ****             envelope_ += releaseAlpha * (detectorInput - envelope_);
 142:effects/autowaheffect.cpp ****         }
 143:effects/autowaheffect.cpp ****         
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccfN9cGW.s 			page 4


 144:effects/autowaheffect.cpp ****         // Apply detector gain to make envelope response more usable with guitar-level signals.
 145:effects/autowaheffect.cpp ****         float scaledEnvelope = std::min(envelope_ * detectorGain, 1.0f);
 146:effects/autowaheffect.cpp **** 
 147:effects/autowaheffect.cpp ****         // Sensitivity sets the maximum frequency deviation from base frequency in Hz.
 148:effects/autowaheffect.cpp ****         float modulatedFreq = baseFreq + (scaledEnvelope * sensitivityHz);
 149:effects/autowaheffect.cpp ****         float floorHz = (sensitivityHz >= 0.0f) ? 20.0f : 100.0f;
 150:effects/autowaheffect.cpp ****         modulatedFreq = std::max(floorHz, std::min(modulatedFreq, 5000.0f));
 151:effects/autowaheffect.cpp ****         filterL_.SetFreq(modulatedFreq);
 152:effects/autowaheffect.cpp ****         filterR_.SetFreq(modulatedFreq);
 153:effects/autowaheffect.cpp ****         
 154:effects/autowaheffect.cpp ****         filterL_.Process(inL[i]);
 155:effects/autowaheffect.cpp ****         filterR_.Process(inR[i]);
 156:effects/autowaheffect.cpp ****         
 157:effects/autowaheffect.cpp ****         float wetL = filterL_.Band();  // Get bandpass output
 158:effects/autowaheffect.cpp ****         float wetR = filterR_.Band();
 159:effects/autowaheffect.cpp ****         
 160:effects/autowaheffect.cpp ****         outL[i] = inL[i] * (1.0f - mix) + wetL * mix;
 161:effects/autowaheffect.cpp ****         outR[i] = inR[i] * (1.0f - mix) + wetR * mix;
 162:effects/autowaheffect.cpp ****     }
 163:effects/autowaheffect.cpp **** }
