   5:effects/autowaheffect.cpp **** using namespace perspective;
   6:effects/autowaheffect.cpp **** using namespace daisysp;
   7:effects/autowaheffect.cpp **** 
   8:effects/autowaheffect.cpp **** static constexpr float MIN_DETECTOR_GAIN = 5.0f;
   9:effects/autowaheffect.cpp **** static constexpr float MAX_DETECTOR_GAIN = 9.0f;
  10:effects/autowaheffect.cpp **** static constexpr float ATTACK_MIN_SEC = 0.001f;
  11:effects/autowaheffect.cpp **** static constexpr float ATTACK_MAX_SEC = 0.5f;
  12:effects/autowaheffect.cpp **** 
  13:effects/autowaheffect.cpp **** static float DetectorGainFromAttack(float attackTimeSec) {
  14:effects/autowaheffect.cpp ****     float clampedAttack = std::max(ATTACK_MIN_SEC, std::min(attackTimeSec, ATTACK_MAX_SEC));
  15:effects/autowaheffect.cpp ****     float normalized = (clampedAttack - ATTACK_MIN_SEC) / (ATTACK_MAX_SEC - ATTACK_MIN_SEC);
  16:effects/autowaheffect.cpp ****     return MIN_DETECTOR_GAIN + normalized * (MAX_DETECTOR_GAIN - MIN_DETECTOR_GAIN);
  17:effects/autowaheffect.cpp **** }
