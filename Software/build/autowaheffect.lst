 165:effects/autowaheffect.cpp **** void AutowahEffect::Update() {
 166:effects/autowaheffect.cpp ****     // Update filter parameters from effect parameters
 167:effects/autowaheffect.cpp ****     if (parameters_.size() >= 6) {
 168:effects/autowaheffect.cpp ****         // Mix parameter (index 0) - handled in Process
 169:effects/autowaheffect.cpp ****         // Frequency parameter (index 2) - handled in Process
 170:effects/autowaheffect.cpp ****         // Attack parameter (index 3) - handled in Process
 171:effects/autowaheffect.cpp ****         // Release parameter (index 4) - handled in Process
 172:effects/autowaheffect.cpp ****         // Sensitivity parameter (index 5) - handled in Process
 173:effects/autowaheffect.cpp ****         
 174:effects/autowaheffect.cpp ****         // Resonance parameter (index 1) maps directly to the SVF resonance input
 175:effects/autowaheffect.cpp ****         float resonance = parameters_[1]->GetValue();
 176:effects/autowaheffect.cpp ****         filterL_.SetRes(resonance);
 177:effects/autowaheffect.cpp ****         filterR_.SetRes(resonance);
 178:effects/autowaheffect.cpp ****     }
 179:effects/autowaheffect.cpp **** }
