  51:effects/autowaheffect.cpp **** void AutowahEffect::Process(float* in, float* out, size_t size) {
  52:effects/autowaheffect.cpp ****     if (!enabled_) {
  53:effects/autowaheffect.cpp ****         detectorInput_ = 0.0f;
  54:effects/autowaheffect.cpp ****         // Bypass - pass through dry signal
  55:effects/autowaheffect.cpp ****         for (size_t i = 0; i < size; i++) {
  56:effects/autowaheffect.cpp ****             out[i] = in[i];
  57:effects/autowaheffect.cpp ****         }
  58:effects/autowaheffect.cpp ****         return;
  59:effects/autowaheffect.cpp ****     }
  60:effects/autowaheffect.cpp ****     
  61:effects/autowaheffect.cpp ****     // Get mix parameter
  62:effects/autowaheffect.cpp ****     float mix = parameters_.size() > 0 ? parameters_[0]->GetValue() : 0.5f;
  63:effects/autowaheffect.cpp **** 
  64:effects/autowaheffect.cpp ****     // Get parameters
  65:effects/autowaheffect.cpp ****     float baseFreq = parameters_.size() >= 6 ? parameters_[2]->GetValue() : 1000.0f;
  66:effects/autowaheffect.cpp ****     float attackTime = parameters_.size() >= 6 ? parameters_[3]->GetValue() : 0.1f;
  67:effects/autowaheffect.cpp ****     float releaseTime = parameters_.size() >= 6 ? parameters_[4]->GetValue() : 0.001f;
  68:effects/autowaheffect.cpp ****     float sensitivityHz = parameters_.size() >= 6 ? parameters_[5]->GetValue() : 1600.0f;
  69:effects/autowaheffect.cpp **** 
  70:effects/autowaheffect.cpp ****     // Convert attack/release times to one-pole coefficients.
  71:effects/autowaheffect.cpp ****     float attackSec = std::max(0.0001f, attackTime);
  72:effects/autowaheffect.cpp ****     float releaseSec = std::max(0.0001f, releaseTime);
  73:effects/autowaheffect.cpp ****     float detectorGain = DetectorGainFromAttack(attackSec);
  74:effects/autowaheffect.cpp ****     float attackAlpha = 1.0f - expf(-1.0f / (sampleRate_ * attackSec));
  75:effects/autowaheffect.cpp ****     float releaseAlpha = 1.0f - expf(-1.0f / (sampleRate_ * releaseSec));
  76:effects/autowaheffect.cpp **** 
  77:effects/autowaheffect.cpp ****     // Process with wet/dry blend
  78:effects/autowaheffect.cpp ****     for (size_t i = 0; i < size; i++) {
  79:effects/autowaheffect.cpp ****         float detectorInput = std::min(std::fabs(in[i]) * detectorGain, 1.0f);
  80:effects/autowaheffect.cpp ****         detectorInput_ = detectorInput;
  81:effects/autowaheffect.cpp **** 
  82:effects/autowaheffect.cpp ****         // Envelope follower with independent attack/release time constants.
  83:effects/autowaheffect.cpp ****         if (detectorInput > envelope_) {
  84:effects/autowaheffect.cpp ****             envelope_ += attackAlpha * (detectorInput - envelope_);
  85:effects/autowaheffect.cpp ****         } else {
  86:effects/autowaheffect.cpp ****             envelope_ += releaseAlpha * (detectorInput - envelope_);
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccfN9cGW.s 			page 3


  87:effects/autowaheffect.cpp ****         }
  88:effects/autowaheffect.cpp **** 
  89:effects/autowaheffect.cpp ****         // Apply detector gain to make envelope response more usable with guitar-level signals.
  90:effects/autowaheffect.cpp ****         float scaledEnvelope = std::min(envelope_ * detectorGain, 1.0f);
  91:effects/autowaheffect.cpp **** 
  92:effects/autowaheffect.cpp ****         // Sensitivity sets the maximum frequency deviation from base frequency in Hz.
  93:effects/autowaheffect.cpp ****         float modulatedFreq = baseFreq + (scaledEnvelope * sensitivityHz);
  94:effects/autowaheffect.cpp ****         float floorHz = (sensitivityHz >= 0.0f) ? 20.0f : 100.0f;
  95:effects/autowaheffect.cpp ****         modulatedFreq = std::max(floorHz, std::min(modulatedFreq, 5000.0f));
  96:effects/autowaheffect.cpp ****         filterL_.SetFreq(modulatedFreq);
  97:effects/autowaheffect.cpp **** 
  98:effects/autowaheffect.cpp ****         filterL_.Process(in[i]);
  99:effects/autowaheffect.cpp ****         float wet = filterL_.Band();  // Get bandpass output
 100:effects/autowaheffect.cpp ****         out[i] = in[i] * (1.0f - mix) + wet * mix;
 101:effects/autowaheffect.cpp ****     }
 102:effects/autowaheffect.cpp **** }
