  58:ui/uieventhandler.cpp **** void UIEventHandler::DispatchEventToListeners(const UIEvent& event) {
  59:ui/uieventhandler.cpp ****     //Hardware::PrintLine("Dispatching event: type=%d, source=%p, controlIndex=%d, value=%d", event
  60:ui/uieventhandler.cpp ****     for (const auto& listener : listeners_) {
  61:ui/uieventhandler.cpp ****         // Check if listener matches event type
  62:ui/uieventhandler.cpp ****         if (listener.eventType == event.type) {
  63:ui/uieventhandler.cpp ****             // Check if listener is for this specific source or all sources
  64:ui/uieventhandler.cpp ****             bool sourceMatches = (listener.source == nullptr || listener.source == event.source);
  65:ui/uieventhandler.cpp ****             // Check if listener is for this specific control index or all indices
  66:ui/uieventhandler.cpp ****             bool indexMatches = (listener.controlIndex == -1 || listener.controlIndex == event.cont
  67:ui/uieventhandler.cpp ****             
  68:ui/uieventhandler.cpp ****             if (sourceMatches && indexMatches) {
  69:ui/uieventhandler.cpp ****                 //Hardware::PrintLine("Dispatching event to listener: eventType=%d, source=%p, cont
  70:ui/uieventhandler.cpp ****                 listener.callback(event);
  71:ui/uieventhandler.cpp ****             }
  72:ui/uieventhandler.cpp ****         }
  73:ui/uieventhandler.cpp ****     }
  74:ui/uieventhandler.cpp **** }
