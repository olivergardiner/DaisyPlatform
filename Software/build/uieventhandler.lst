  52:ui/uieventhandler.cpp **** void UIEventHandler::ClearQueue() {
  53:ui/uieventhandler.cpp ****     while (!eventQueue_.empty()) {
  54:ui/uieventhandler.cpp ****         PopEvent();
  55:ui/uieventhandler.cpp ****     }
  56:ui/uieventhandler.cpp **** }
