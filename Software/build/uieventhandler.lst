  37:ui/uieventhandler.cpp **** void UIEventHandler::ProcessEvents() {
  38:ui/uieventhandler.cpp ****     while (!eventQueue_.empty()) {
  39:ui/uieventhandler.cpp ****         UIEvent event = PopEvent();
  40:ui/uieventhandler.cpp ****         if (event.type == UIEventType::KNOB_CHANGED) {
  41:ui/uieventhandler.cpp ****             Knob *knob = static_cast<Knob*>(event.source);
  42:ui/uieventhandler.cpp ****             knob->Filter();
  43:ui/uieventhandler.cpp ****         }
  44:ui/uieventhandler.cpp ****         DispatchEventToListeners(event);
  45:ui/uieventhandler.cpp ****     }
  46:ui/uieventhandler.cpp **** }
  47:ui/uieventhandler.cpp **** 
