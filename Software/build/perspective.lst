 349:perspective.cpp **** void Perspective::LoadEffects() {
 350:perspective.cpp ****     // Populate effects vector using the factory function
 351:perspective.cpp ****     float sampleRate = hardware.AudioSampleRate();
 352:perspective.cpp ****     PopulateEffects(&effects_, sampleRate);
 353:perspective.cpp ****     
 354:perspective.cpp ****     // Initialize tuner separately (not part of effects list)
 355:perspective.cpp ****     tunerEffect_ = new TunerEffect();
 356:perspective.cpp ****     tunerEffect_->Init(sampleRate);
 357:perspective.cpp ****     
 358:perspective.cpp ****     // Set display update callback for all effects
 359:perspective.cpp ****     for (auto* effect : effects_) {
 360:perspective.cpp ****         effect->SetDisplayUpdateCallback([this](EffectParameter* param, size_t displayIndex) {
 361:perspective.cpp ****             this->UpdateParameterDisplay(param, displayIndex + 1); // +1 to skip effect name displa
 362:perspective.cpp ****         });
 363:perspective.cpp ****     }
 364:perspective.cpp ****     
 365:perspective.cpp ****     // Set the first effect as current
 366:perspective.cpp ****     SetCurrentEffect(0);
 367:perspective.cpp **** }
