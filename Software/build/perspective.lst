 369:perspective.cpp **** void Perspective::SetCurrentEffect(size_t index) {
 370:perspective.cpp ****     if (index >= effects_.size()) {
 371:perspective.cpp ****         return; // Invalid index
 372:perspective.cpp ****     }
 373:perspective.cpp **** 
 374:perspective.cpp ****     if (currentEffect_) {
 375:perspective.cpp ****         currentEffect_->OnDeselected();
 376:perspective.cpp ****     }
 377:perspective.cpp ****     
 378:perspective.cpp ****     currentEffectIndex_ = index;
 379:perspective.cpp ****     currentEffect_ = effects_[index];
 380:perspective.cpp ****     currentEffect_->OnSelected();
 381:perspective.cpp ****     
 382:perspective.cpp ****     // Propagate global metronome state to new effect (propagates through compound effect hierarchy
 383:perspective.cpp ****     currentEffect_->SetMetronomeEnabled(metronomeEnabled_);
 384:perspective.cpp ****     
 385:perspective.cpp ****     // Update effect to apply metronome state propagation through compound effect children
 386:perspective.cpp ****     currentEffect_->Update();
 387:perspective.cpp ****     
 388:perspective.cpp ****     // Clear the display before showing new effect
 389:perspective.cpp ****     hardware.ClearDisplay();
 390:perspective.cpp ****     
 391:perspective.cpp ****     hardware.SetParameterDisplay(0, currentEffect_->GetName(), "");
 392:perspective.cpp ****     
