 281:perspective.cpp **** void Perspective::ToggleBypass() {
 282:perspective.cpp ****     bypassMode_ = !bypassMode_;
 283:perspective.cpp ****     
 284:perspective.cpp ****     // Control hardware true bypass relay
 285:perspective.cpp ****     if (bypassMode_ && bypassType_ == BypassType::TRUE_BYPASS) {
 286:perspective.cpp ****         hardware.SetTrueBypass(true);  // Drive pin LOW to activate relay
 287:perspective.cpp ****     } else {
 288:perspective.cpp ****         hardware.SetTrueBypass(false); // Drive pin HIGH to deactivate relay
 289:perspective.cpp ****     }
 290:perspective.cpp ****     
 291:perspective.cpp ****     UpdateStatusDisplay();
 292:perspective.cpp **** }
 293:perspective.cpp **** 
 294:perspective.cpp **** void Perspective::ToggleBypassType() {
 295:perspective.cpp ****     // Toggle between true bypass and passthrough
 296:perspective.cpp ****     if (bypassType_ == BypassType::TRUE_BYPASS) {
 297:perspective.cpp ****         bypassType_ = BypassType::PASSTHROUGH;
 298:perspective.cpp ****     } else {
 299:perspective.cpp ****         bypassType_ = BypassType::TRUE_BYPASS;
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccv4ealb.s 			page 54


 300:perspective.cpp ****     }
 301:perspective.cpp ****     
 302:perspective.cpp ****     // Update hardware relay state
 303:perspective.cpp ****     if (bypassMode_ && bypassType_ == BypassType::TRUE_BYPASS) {
 304:perspective.cpp ****         hardware.SetTrueBypass(true);  // Drive pin LOW to activate relay
 305:perspective.cpp ****     } else {
 306:perspective.cpp ****         hardware.SetTrueBypass(false); // Drive pin HIGH to deactivate relay
 307:perspective.cpp ****     }
 308:perspective.cpp ****     
 309:perspective.cpp ****     UpdateStatusDisplay();
 310:perspective.cpp ****     hardware.ForceKnobValueChangedEvents();
 311:perspective.cpp **** }
