 153:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
 154:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // Implementation
 155:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
 156:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 157:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
 158:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // peak_envelope_follower
 159:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    inline peak_envelope_follower::peak_envelope_follower(duration release, float sps)
 160:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       : _release(fast_exp3(-2.0f / (sps * as_double(release))))
 161:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    {}
 162:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 163:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    inline float peak_envelope_follower::operator()(float s)
 164:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    {
 165:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       if (s > y)
 166:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****          y = s;
 167:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       else
 168:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****          y = s + _release * (y - s);
 169:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       return y;
 170:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    }
 171:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 172:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    inline float peak_envelope_follower::operator()() const
 173:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    {
 174:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       return y;
 175:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    }
 176:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 177:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    inline peak_envelope_follower& peak_envelope_follower::operator=(float y_)
 178:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    {
