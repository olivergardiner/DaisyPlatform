 180:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       return *this;
 181:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    }
 182:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 183:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    inline void peak_envelope_follower::release(duration release_, float sps)
 184:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    {
 185:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       _release = fast_exp3(-2.0f / (sps * as_double(release_)));
 186:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    }
 187:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 188:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 189:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
