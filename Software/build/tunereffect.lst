  97:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
  98:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
  99:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // This is a fast_envelope_follower followed by a moving average filter to
 100:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // smooth out the staircase ripples as mentioned in the
 101:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // fast_envelope_follower notes.
 102:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
