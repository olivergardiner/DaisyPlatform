  18:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // During the attack phase of an audio signal, the peak envelope follower
  19:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // closely tracks the maximum peak level. When the signal level drops
  20:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // below the peak, the follower gradually releases the peak level with an
  21:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // exponential decay.
