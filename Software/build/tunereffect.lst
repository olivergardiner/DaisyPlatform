  18:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp **** {
  19:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    ////////////////////////////////////////////////////////////////////////////
  20:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // The zero_crossing class saves zero-crossing information necessary to
  21:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // extract accurate timing information such as periods between pulses for
  22:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // performing analysis such as bitstream autocorrelation.
  23:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    //
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAfT6In.s 			page 43


  24:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // Each zero crossing pulse is saved in a ring buffer of info elements.
  25:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // Data include the maximum height of the waveform bounded by the pulse,
  26:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // the pulse width, as well as the leading edge and trailing edge frame
  27:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // positions (number of samples from the start) and y coordinates (the
  28:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // sample values before and after each zero crossing) of the zero
  29:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // crossings.
  30:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    //
  31:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // Only the latest few (finite amount) of zero crossing information is
  32:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // saved, given by the window constructor parameter. The window is the
  33:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // number of frames (samples) of information held by the zero_crossing
  34:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // data structure.
  35:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    //
  36:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // Each call to the function operator, given a sample s, returns the
  37:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // zero-crossing state (bool). is_ready() returns true when we have
  38:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // sufficient info to perform analysis. is_ready() returns true after
  39:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // every window/2 frames. Information about each zero crossing can be
  40:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // obtained using the index operator[]. The leftmost edge (oldest) is at
  41:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // the 0th index while the rightmost edge (latest) is at index
  42:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // num_edges()-1.
  43:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    //
  44:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // After window/2 frames, the leading edge and trailing edge frame
  45:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // positions are shifted by -window/2 such that an edge at frame index N
  46:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // will be shifted to N-window/2. For example, if the window size is 100
  47:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // and the leading edge is at frame 45, it will be shifted to -5 (45-50).
  48:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    //
  49:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // This procedure is done to ensure seamless operation from one window to
  50:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // the next. In the example above, frame index -5 is already past the left
  51:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // side of the window, but will still be kept as long as the trailing edge
  52:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // is still within the window. Take note that it is also possible for the
  53:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // latest edge to have a trailing edge that goes past the right side of
  54:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // the window. If for example, with the same window size 100, there can be
  55:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    // an edge with a leading edge at 95 and trailing edge at 120.
  56:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    ////////////////////////////////////////////////////////////////////////////
  57:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****    class zero_crossing_collector
