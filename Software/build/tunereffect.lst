 117:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 118:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
 119:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // This rms envelope follower combines fast response, low ripple using
 120:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // moving RMS detection and the fast_ave_envelope_follower for
 121:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // tracking the moving RMS.
 122:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    //
 123:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // The signal path is as follows:
 124:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    //    1. Square signal
 125:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    //    2. Fast averaging envelope follower
 126:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    //    3. Square root.
 127:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    //
 128:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // The `fast_rms_envelope_follower_db` variant works in the dB domain,
 129:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // which makes it easy to use as an envelope follower for dynamic range
 130:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // effects (compressor, expander, and agc) which already work in the dB
 131:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // domain, so we eliminate a linear to decibel conversion and optimize
 132:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // computation by using division by 2 instead of sqrt as an added bonus.
 133:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    //
 134:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // Designed by Joel de Guzman (June 2020)
 135:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
 136:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    struct fast_rms_envelope_follower
 137:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    {
 138:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       constexpr static auto threshold = lin_float(-120_dB);
 139:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 140:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****                fast_rms_envelope_follower(duration hold, float sps);
 141:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       float    operator()(float s);
 142:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 143:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       fast_ave_envelope_follower  _fenv;
 144:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    };
 145:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 146:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    struct fast_rms_envelope_follower_db : fast_rms_envelope_follower
 147:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    {
 148:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       using fast_rms_envelope_follower::fast_rms_envelope_follower;
 149:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
 150:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       decibel operator()(float s);
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAfT6In.s 			page 216


 151:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    };
