  11:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp **** namespace cycfi::q
  12:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp **** {
  13:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    ////////////////////////////////////////////////////////////////////////////
  14:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // compressor dynamically modulates the gain when the signal envelope
  15:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // rises above a specified threshold. Envelope tracking is done using an
  16:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // external envelope follower to make it possible to use different types
  17:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // of envelope tracking schemes, the output of which is the supplied 'env'
  18:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // argument to the function call operator operator()(decibel env) where
  19:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // env is the envelope of the signal in decibels obtained (e.g) using the
  20:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // envelope_follower.
  21:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    //
  22:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // Note that these are envelope processors that work in the logarithmic
  23:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // domain (decibels) and process envelopes instead of the actual signal.
  24:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // The output is the compressed envelope, also in decibels. Simply
  25:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // multiply the signal by the result converted to float (or double). For
  26:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // example:
  27:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    //
  28:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    //    auto gain = as_float(comp(env));
  29:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    //    auto left_out = left_signal * gain;
  30:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    //    auto right_out = right_signal * gain;
  31:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    //
  32:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // where left_signal and right_signal are stereo input signals and
  33:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // envelope is the computed envelope (e.g) using an envelope follower.
  34:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    //
  35:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // The ratio parameter specifies the amount of gain applied. With the
  36:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // typical "n:1" notation for compressors, the ratio parameter is 1/n,
  37:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // thereby the ratio for compressors is normally from 0.0...1.0. (e.g. 4:
  38:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // 1 compression is 1/4 or 0.25). Signal rising above the threshold is
  39:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // attenuated, compressing the signal. For every dB above the threshold,
  40:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // the signal is attenuated by n dB. For example, with a ratio of 4:1
  41:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // (0.25), 1dB above the threshold is attenuated by 4dB.
  42:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    //
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAfT6In.s 			page 219


  43:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // Typically, you add some makeup gain after compression to compensate for
  44:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // the gain reduction.
  45:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    ////////////////////////////////////////////////////////////////////////////
  46:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    struct compressor
  47:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    {
  48:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****                   compressor(decibel threshold, float ratio);
  49:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp **** 
  50:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       decibel     operator()(decibel env) const;
  51:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       void        threshold(decibel val);
  52:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       void        ratio(float ratio);
  53:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       decibel     threshold() const;
  54:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       float       ratio() const;
  55:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp **** 
  56:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       decibel     _threshold;
  57:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       float       _slope;
  58:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    };
  59:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp **** 
  60:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    ////////////////////////////////////////////////////////////////////////////
  61:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // The soft_knee_compressor compressor variant provides a more gradual
  62:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // "soft knee" gain transition around the threshold, given a knee width.
  63:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // See compressor above.
  64:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    ////////////////////////////////////////////////////////////////////////////
  65:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    struct soft_knee_compressor
  66:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    {
  67:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****                   soft_knee_compressor(decibel threshold, decibel width, float ratio);
  68:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp **** 
  69:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       decibel     operator()(decibel env) const;
  70:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       void        threshold(decibel val);
  71:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       void        width(decibel val);
  72:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       void        ratio(float ratio);
  73:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       decibel     threshold() const;
  74:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       decibel     width() const;
  75:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       float       ratio() const;
  76:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp **** 
  77:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       decibel     _threshold, _width, _lower, _upper;
  78:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       float       _slope;
  79:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    };
  80:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp **** 
  81:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    ////////////////////////////////////////////////////////////////////////////
  82:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // The expander is the inverse of the compressor. The expander adjusts the
  83:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // gain when the signal falls below the threshold, attenuating the signal.
  84:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // With the typical "1:n" notation for expanders, the ratio parameter is
  85:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // n, thereby the ratio for expanders is normally from 0.0...inf. (e.g.
  86:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // 1 : 4 expansion is 4). A ratio of 1 : inf is a hard gate where no
  87:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // signal passes below the threshold.
  88:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    //
  89:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // For every dB below the threshold, the signal is attenuated by n dB. For
  90:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // example, with a ratio of 4 : 1 (4), 1dB below the threshold is
  91:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    // attenuated by 4dB.
  92:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    ////////////////////////////////////////////////////////////////////////////
  93:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    struct expander
  94:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****    {
  95:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****                   expander(decibel threshold, float ratio);
  96:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp **** 
  97:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       decibel     operator()(decibel env) const;
  98:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       void        threshold(decibel val);
  99:dependencies/cycfi/q/q_lib/include/q/fx/dynamic.hpp ****       void        ratio(float ratio);
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAfT6In.s 			page 220


