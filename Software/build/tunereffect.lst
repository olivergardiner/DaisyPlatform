  62:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
  63:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // This envelope follower combines fast response, low ripple.
  64:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    //
  65:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // Based on https://bit.ly/3zmGLIf, https://bit.ly/40OhYJf
  66:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    //
  67:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // There is no filtering. The output is a jagged, staircase-like envelope.
  68:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // That way, this can be useful for analysis such as onset detection. For
  69:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // monophonic signals, the hold duration should be equal to or slightly
  70:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // longer than 1/div the period of the lowest frequency of the signal we
  71:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // wish to track, where `div` is the sole template parameter. The hold
  72:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // parameter determines the staircase step duration. This staircase-like
  73:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // envelope can be effectively smoothed out using a moving average filter
  74:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // with the same duration as the hold parameter.
  75:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    //
  76:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    // fast_envelope_follower is provided, which has div = 2.
  77:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    ////////////////////////////////////////////////////////////////////////////
  78:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    template <std::size_t div>
  79:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    struct basic_fast_envelope_follower
  80:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    {
  81:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       static_assert(div >= 1, "div must be >= 1");
  82:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       static constexpr std::size_t size = div+1;
  83:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
  84:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****                basic_fast_envelope_follower(duration hold, float sps);
  85:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****                basic_fast_envelope_follower(std::size_t hold_samples);
  86:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
  87:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       float    operator()(float s);
  88:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       float    operator()() const;
  89:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp **** 
  90:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       std::array<float, size> _y;
  91:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       float _peak = 0;
  92:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       std::uint16_t _tick = 0, _i = 0;
  93:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****       std::uint16_t const _reset;
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAfT6In.s 			page 215


  94:dependencies/cycfi/q/q_lib/include/q/fx/envelope.hpp ****    };
