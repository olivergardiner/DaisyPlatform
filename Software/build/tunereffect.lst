  13:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp **** namespace cycfi::q
  14:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp **** {
  15:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    ////////////////////////////////////////////////////////////////////////////
  16:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // The bitstream_acf correlates class a bit stream (stored in a bitset) by
  17:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // itself shifted by position, pos.
  18:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    //
  19:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // In standard ACF (autocorrelation function) the signal is multiplied by
  20:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // a shifted version of itself, delayed by position, pos, with the result
  21:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // accumulated for each point, half the window of interest. The higher the
  22:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // sum, the higher the periodicity.
  23:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    //
  24:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // With bitstream auto correlation, the more efficient XOR operation is
  25:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // used instead. A single XOR operation works on N bits of an integer. We
  26:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // get a speedup factor of N (e.g. 64 for a 64 bit machine) compared to
  27:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // standard ACF, and not to mention that integer bit operations are a lot
  28:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // faster than floating point multiplications).
  29:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    //
  30:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // With XOR you get a one when there’s a mismatch:
  31:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    //
  32:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    //    0 ^ 0 = 0
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAfT6In.s 			page 280


  33:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    //    0 ^ 1 = 1
  34:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    //    1 ^ 0 = 1
  35:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    //    1 ^ 1 = 0
  36:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    //
  37:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // After XOR, the number of bits (set to 1) is counted. The lower the
  38:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // count, the higher the periodicity. A count of zero gives perfect
  39:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    // correlation: there is no mismatch.
  40:dependencies/cycfi/q/q_lib/include/q/utility/bitstream_acf.hpp ****    ////////////////////////////////////////////////////////////////////////////
