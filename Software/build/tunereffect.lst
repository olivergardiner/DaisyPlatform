  17:dependencies/cycfi/q/q_lib/include/q/fx/differentiator.hpp ****    // estimate of the signal slope at each point, which is useful for
  18:dependencies/cycfi/q/q_lib/include/q/fx/differentiator.hpp ****    // detecting signal features such as edges and peaks.
  19:dependencies/cycfi/q/q_lib/include/q/fx/differentiator.hpp ****    //
  20:dependencies/cycfi/q/q_lib/include/q/fx/differentiator.hpp ****    // first_difference has this time-domain expression:
  21:dependencies/cycfi/q/q_lib/include/q/fx/differentiator.hpp ****    //
  22:dependencies/cycfi/q/q_lib/include/q/fx/differentiator.hpp ****    //    y(n) = x(n) - x(n-1)
  23:dependencies/cycfi/q/q_lib/include/q/fx/differentiator.hpp ****    //
