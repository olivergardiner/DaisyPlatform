 136:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    ////////////////////////////////////////////////////////////////////////////
 137:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // This filter consists of two first order low-pass filters in series,
 138:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // with some of the difference between the two filter outputs fed back to
 139:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // give a resonant peak.
 140:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
 141:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // See: https://www.w3.org/2011/audio/audio-eq-cookbook.html
 142:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
 143:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // This is probably faster than the RBJ biquds (see biquad.hpp),
 144:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // especially when computing the coefficients (e.g. when sweeping the
 145:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // frequency) but this filter is rather limited, quirky and inacurate. Use
 146:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // this as a quick and dirty 'musical' filter. E.g. when you don't care
 147:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // about the actual frequency and Q, this one can be swept quickly using a
 148:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // normalized values from 0.0 to less than 1.0, possibly using some custom
 149:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // response curves (e.g. synth filters). Note that _f can't be == 1.0,
 150:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // otherwise, the _fb computation will have a divide by zero. It is also
 151:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // possible to supply the actual frequency, given the sps (samples per
 152:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // second), but take note that the limit is around 7kHz given a sampling
 153:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // rate of 44100, otherwise, the divide by zero.
 154:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
 155:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // Unless you are in a pinch, I'd rather just use the RBJ biquds.
 156:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    ////////////////////////////////////////////////////////////////////////////
 157:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    struct reso_filter
 158:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    {
 159:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       reso_filter(frequency f, float reso, float sps)
 160:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****        : _f(2.0f * fastsin(pi * as_float(f) / sps))
 161:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****        , _fb(reso + reso / (1.0f - _f))
 162:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****        , _reso(reso)
 163:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {}
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAfT6In.s 			page 205


 164:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
 165:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       reso_filter(float f, float reso)
 166:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****        : _f(f)
 167:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****        , _fb(reso + reso / (1.0f - _f))
 168:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****        , _reso(reso)
 169:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {}
 170:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
 171:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       float operator()(float s)
 172:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
 173:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          _y0 += _f * (s - _y0 + _fb * (_y0 - _y1));
 174:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          _y1 += _f * (_y0 - _y1);
 175:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          return _y1;
 176:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
 177:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
 178:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       float operator()() const
 179:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
 180:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          return _y1;
 181:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
 182:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
 183:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       void cutoff(frequency f, float sps)
 184:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
 185:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          _f = 2.0f * fastsin(pi * as_float(f) / sps);
 186:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          _fb = _reso + _reso / (1.0f - _f);
 187:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
 188:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
 189:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       void cutoff(float f)
 190:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
 191:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          _f = f;
 192:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          _fb = _reso + _reso / (1.0f - _f);
 193:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
 194:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
 195:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       void resonance(float reso)
 196:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
 197:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          _reso = reso;
