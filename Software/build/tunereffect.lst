 154:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    ////////////////////////////////////////////////////////////////////////////
 155:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    // Fast reciprocal. See http://tinyurl.com/lgmnsyg. We want to avoid
 156:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    // multiplication. So instead of 1.0f/val, we use this function which
 157:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    // is inaccurate, but fast substitute. It works by negating the exponent
 158:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    // which is assumed to be IEEE754.
 159:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    ////////////////////////////////////////////////////////////////////////////
 160:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    inline float fast_inverse(float val)
 161:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    {
 162:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****       auto x = reinterpret_cast<std::int32_t&>(val);
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAfT6In.s 			page 519


 163:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****       x = 0x7EF311C2 - x;
 164:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****       return reinterpret_cast<float&>(x);
 165:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    }
 166:dependencies/cycfi/q/q_lib/include/q/support/base.hpp **** 
 167:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    ////////////////////////////////////////////////////////////////////////////
 168:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    // Fast division using multiplication and fast_inverse
 169:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    ////////////////////////////////////////////////////////////////////////////
 170:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    inline float fast_div(float a, float b)
 171:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    {
 172:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****       return a * fast_inverse(b);
 173:dependencies/cycfi/q/q_lib/include/q/support/base.hpp ****    }
 174:dependencies/cycfi/q/q_lib/include/q/support/base.hpp **** 
