  14:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    // 3-point 1D median filter. Returns the median of 3 latest samples. The
  15:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    // median filter is a nonlinear digital filter often used to remove noise
  16:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    // from signals. The median filter performs better than a moving average
  17:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    // filter in reducing noise, especially outliers (sudden jumps in the
  18:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    // signal (impulsive noise)). The median filter, however, requires more
  19:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    // processing cycles.
  20:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    ////////////////////////////////////////////////////////////////////////////
  21:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    inline float median3f(float a, float b, float c)
  22:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    {
  23:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****       return std::max(std::min(a, b), std::min(std::max(a, b), c));
  24:dependencies/cycfi/q/q_lib/include/q/fx/median.hpp ****    }
