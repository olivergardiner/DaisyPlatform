 166:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****       // Get the start edge
 167:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****       auto prev1 = _crossing.first;
 168:dependencies/cycfi/q/q_lib/include/q/utility/zero_crossing_collector.hpp ****       auto curr1 = _crossing.second;
