 210:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
 211:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // A robust and inexpensive dynamic smoothing algorithm based on using the
 212:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // bandpass output of a 2-pole multimode filter to modulate its own cutoff
 213:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // frequency. The bandpass signal measures how much the signal is
 214:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // "changing," making it useful for dynamically increasing the cutoff
 215:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // frequency and allowing for faster tracking when the input signal
 216:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // changes more. The absolute value of the bandpass signal is used since
 217:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // either an upward or downward change should increase the cutoff.
