  12:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** namespace cycfi::q
  13:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** {
  14:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    ////////////////////////////////////////////////////////////////////////////
  15:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // fixed_pt_leaky_integrator: If you want a fast filter for integers, use
  16:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // a fixed point leaky-integrator. k will determine the effect of the
  17:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // filter. Choose k to be a power of 2 for efficiency (the compiler will
  18:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // optimize the computation using shifts). k = 16 is a good starting
  19:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // point.
  20:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
  21:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // This simulates the RC filter in digital form. The equation is:
  22:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
  23:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //    y[i] = rho * y[i-1] + s
  24:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
  25:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // where rho < 1. To avoid floating point, we use k instead, which
  26:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // allows for integer operations. In terms of k, rho = 1 - (1 / k).
  27:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // So the actual formula is:
  28:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
  29:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //    y[i] += s - (y[i-1] / k);
  30:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
  31:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // k will also be the filter gain, so the final result should be divided
  32:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // by k. If you need to initialize the filter (y member) to a certain
  33:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // state, you will also need to multiply the initial value by k.
  34:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    //
  35:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    ////////////////////////////////////////////////////////////////////////////
  36:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    template <int k, typename T = int>
  37:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    struct fixed_pt_leaky_integrator
  38:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    {
  39:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       typedef T result_type;
  40:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       static constexpr int gain = k;
  41:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  42:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       T operator()(T s)
  43:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
  44:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          y += s - (y / k);
  45:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          return y;
  46:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
  47:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  48:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       T operator()() const
  49:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAfT6In.s 			page 203


  50:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          return y;
  51:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
  52:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  53:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       fixed_pt_leaky_integrator& operator=(float y_)
  54:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
  55:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          y = y_;
  56:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          return *this;
  57:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
  58:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  59:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       T y = 0;
  60:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    };
  61:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  62:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    ////////////////////////////////////////////////////////////////////////////
  63:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // Leaky Integrator
  64:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    ////////////////////////////////////////////////////////////////////////////
  65:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    struct leaky_integrator
  66:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    {
  67:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       leaky_integrator(float a = 0.995)
  68:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****        : a(a)
  69:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {}
  70:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  71:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       leaky_integrator(frequency f, float sps)
  72:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****        : a(1.0f -(2_pi * as_double(f) / sps))
  73:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {}
  74:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  75:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       float operator()(float s)
  76:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
  77:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          return y = s + a * (y - s);
  78:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
  79:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  80:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       float operator()() const
  81:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
  82:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          return y;
  83:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
  84:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  85:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       leaky_integrator& operator=(float y_)
  86:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
  87:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          y = y_;
  88:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          return *this;
  89:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
  90:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  91:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       void cutoff(frequency f, float sps)
  92:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       {
  93:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****          a = 1.0f -(2_pi * as_double(f) / sps);
  94:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       }
  95:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  96:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****       float y = 0.0f, a;
  97:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    };
  98:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp **** 
  99:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    ////////////////////////////////////////////////////////////////////////////
 100:dependencies/cycfi/q/q_lib/include/q/fx/lowpass.hpp ****    // Basic one pole low-pass filter (6dB/Oct)
