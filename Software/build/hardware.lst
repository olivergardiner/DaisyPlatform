   1:dependencies/DaisySeedGFX2/cDisplay.h **** //====================================================================================
   2:dependencies/DaisySeedGFX2/cDisplay.h **** // cDisplay
   3:dependencies/DaisySeedGFX2/cDisplay.h **** //  Management of an SPI-based display on an STM32 processor
   4:dependencies/DaisySeedGFX2/cDisplay.h **** //  Features:
   5:dependencies/DaisySeedGFX2/cDisplay.h **** //  - Transfers only modified blocks to optimize performance
   6:dependencies/DaisySeedGFX2/cDisplay.h **** //  - Uses a framebuffer and multiple layers for rendering
   7:dependencies/DaisySeedGFX2/cDisplay.h **** //  
   8:dependencies/DaisySeedGFX2/cDisplay.h **** // Copyright (c) 2025 Dad Design.
