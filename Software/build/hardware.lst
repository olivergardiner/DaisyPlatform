   8:dependencies/libDaisy/src/per/tim.h **** namespace daisy
   9:dependencies/libDaisy/src/per/tim.h **** {
  10:dependencies/libDaisy/src/per/tim.h **** /** @brief Hardare timer peripheral support.
  11:dependencies/libDaisy/src/per/tim.h ****  ** 
  12:dependencies/libDaisy/src/per/tim.h ****  ** Supports general-function TIM peripherals:
  13:dependencies/libDaisy/src/per/tim.h ****  ** - TIM2, TIM3, TIM4, TIM5
  14:dependencies/libDaisy/src/per/tim.h ****  **
  15:dependencies/libDaisy/src/per/tim.h ****  ** DaisySeed, and many internal peripherals utilize TIM2 for timing/delay purposes.
  16:dependencies/libDaisy/src/per/tim.h ****  ** It is configured to be at the maximum frequency: typically 200MHz or 240MHz (boost) 
  17:dependencies/libDaisy/src/per/tim.h ****  ** for measuring/delaying for very short periods. 
  18:dependencies/libDaisy/src/per/tim.h ****  **
  19:dependencies/libDaisy/src/per/tim.h ****  ** The GetUs/GetMs functions are available for convenience (and backwards compatibility),
  20:dependencies/libDaisy/src/per/tim.h ****  ** but to avoid wrapping errors on math when doing time-delta calculations, using ticks is 
  21:dependencies/libDaisy/src/per/tim.h ****  ** recommended. The data can be converted to the final time-base after getting the difference in t
  22:dependencies/libDaisy/src/per/tim.h ****  ** (Using GetFreq() can be used for these time-base calculations).
  23:dependencies/libDaisy/src/per/tim.h ****  **
  24:dependencies/libDaisy/src/per/tim.h ****  ** User callbacks can be set, and changed at any point during operation. However,
  25:dependencies/libDaisy/src/per/tim.h ****  ** the Config::enable_irq must be set to true when initializing for the interrupts
  26:dependencies/libDaisy/src/per/tim.h ****  ** to turn on and function.
  27:dependencies/libDaisy/src/per/tim.h ****  **
  28:dependencies/libDaisy/src/per/tim.h ****  ** @todo Fix issues with realtime getters, and wrapping of the timer(s).
  29:dependencies/libDaisy/src/per/tim.h ****  **     - This very noticeable with default settings for the 16-bit counters.
  30:dependencies/libDaisy/src/per/tim.h ****  ** @todo Other General purpose timers
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\cch4Kre8.s 			page 48


  31:dependencies/libDaisy/src/per/tim.h ****  ** @todo Non-internal clock sources
  32:dependencies/libDaisy/src/per/tim.h ****  ** @todo Use of the four-tim channels per tim
  33:dependencies/libDaisy/src/per/tim.h ****  **     - PWM, etc.
  34:dependencies/libDaisy/src/per/tim.h ****  **     - InputCapture/OutputCompare, etc.
  35:dependencies/libDaisy/src/per/tim.h ****  ** @todo HRTIM
  36:dependencies/libDaisy/src/per/tim.h ****  ** @todo Advanced timers (TIM1/TIM8)
  37:dependencies/libDaisy/src/per/tim.h ****  ** */
  38:dependencies/libDaisy/src/per/tim.h **** class TimerHandle
  39:dependencies/libDaisy/src/per/tim.h **** {
  40:dependencies/libDaisy/src/per/tim.h ****   public:
  41:dependencies/libDaisy/src/per/tim.h ****     /** @brief Configuration struct for the Peripheral
  42:dependencies/libDaisy/src/per/tim.h ****      *  @note These settings are used during initialization
  43:dependencies/libDaisy/src/per/tim.h ****      *   and changing them afterwards may not have the desired effect.
  44:dependencies/libDaisy/src/per/tim.h ****      */
  45:dependencies/libDaisy/src/per/tim.h ****     struct Config
  46:dependencies/libDaisy/src/per/tim.h ****     {
  47:dependencies/libDaisy/src/per/tim.h ****         /** @brief Hardware Timer to configure, and use. */
  48:dependencies/libDaisy/src/per/tim.h ****         enum class Peripheral
  49:dependencies/libDaisy/src/per/tim.h ****         {
  50:dependencies/libDaisy/src/per/tim.h ****             TIM_2 = 0, /**< 32-bit counter */
  51:dependencies/libDaisy/src/per/tim.h ****             TIM_3,     /**< 16-bit counter */
  52:dependencies/libDaisy/src/per/tim.h ****             TIM_4,     /**< 16-bit counter */
  53:dependencies/libDaisy/src/per/tim.h ****             TIM_5,     /**< 32-bit counter*/
  54:dependencies/libDaisy/src/per/tim.h ****         };
  55:dependencies/libDaisy/src/per/tim.h **** 
  56:dependencies/libDaisy/src/per/tim.h ****         /** @brief Direction of the auto-reload counter. 
  57:dependencies/libDaisy/src/per/tim.h ****          ** @todo Add support for the various  
  58:dependencies/libDaisy/src/per/tim.h ****          ** versions of Up/Down counters.
  59:dependencies/libDaisy/src/per/tim.h ****          ** */
  60:dependencies/libDaisy/src/per/tim.h ****         enum class CounterDir
  61:dependencies/libDaisy/src/per/tim.h ****         {
  62:dependencies/libDaisy/src/per/tim.h ****             UP = 0,
  63:dependencies/libDaisy/src/per/tim.h ****             DOWN,
  64:dependencies/libDaisy/src/per/tim.h ****         };
  65:dependencies/libDaisy/src/per/tim.h **** 
  66:dependencies/libDaisy/src/per/tim.h ****         Peripheral periph; /**< Hardware Peripheral */
  67:dependencies/libDaisy/src/per/tim.h ****         CounterDir dir;    /**< Counter direction */
  68:dependencies/libDaisy/src/per/tim.h **** 
  69:dependencies/libDaisy/src/per/tim.h ****         /** @brief period in ticks at TIM frequency that counter will reset based on dir
  70:dependencies/libDaisy/src/per/tim.h ****          *  @note TIM3 and TIM4 are both 16-bit timers. So the period maximum is 0xffff.
  71:dependencies/libDaisy/src/per/tim.h ****         */
  72:dependencies/libDaisy/src/per/tim.h ****         uint32_t period;
  73:dependencies/libDaisy/src/per/tim.h ****         bool     enable_irq; /**< Enable interrupt for user based callback */
  74:dependencies/libDaisy/src/per/tim.h **** 
  75:dependencies/libDaisy/src/per/tim.h ****         /* @brief Constructor for default states */
  76:dependencies/libDaisy/src/per/tim.h ****         Config()
  77:dependencies/libDaisy/src/per/tim.h ****         : periph(Peripheral::TIM_2),
  78:dependencies/libDaisy/src/per/tim.h ****           dir(CounterDir::UP),
  79:dependencies/libDaisy/src/per/tim.h ****           period(0xffffffff),
  80:dependencies/libDaisy/src/per/tim.h ****           enable_irq(false)
  81:dependencies/libDaisy/src/per/tim.h ****         {
