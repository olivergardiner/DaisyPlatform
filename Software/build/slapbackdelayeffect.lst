  24:effects/slapbackdelayeffect.cpp **** void SlapbackDelayEffect::Init(float sampleRate) {
  25:effects/slapbackdelayeffect.cpp ****     sampleRate_ = sampleRate;
  26:effects/slapbackdelayeffect.cpp ****     
  27:effects/slapbackdelayeffect.cpp ****     // Initialize delay lines for stereo
  28:effects/slapbackdelayeffect.cpp ****     slapbackDelayL_.Init();
  29:effects/slapbackdelayeffect.cpp ****     slapbackDelayR_.Init();
  30:effects/slapbackdelayeffect.cpp ****     
  31:effects/slapbackdelayeffect.cpp ****     // Add parameters: Mix, Feedback, Time
  32:effects/slapbackdelayeffect.cpp ****     // Mix: 0-100%
  33:effects/slapbackdelayeffect.cpp ****     AddParameter(new PotentiometerParameter("K1 Mix", 0.0f, 1.0f, 0.50f, PotCurve::LIN, KNOB_1_IDX)
  34:effects/slapbackdelayeffect.cpp ****     parameters_.back()->SetDisplayType(DisplayType::SCALED);
  35:effects/slapbackdelayeffect.cpp ****     parameters_.back()->SetScaleFactor(100.0f);
  36:effects/slapbackdelayeffect.cpp ****     
  37:effects/slapbackdelayeffect.cpp ****     // Feedback: 0-70% (slapback typically has minimal feedback)
  38:effects/slapbackdelayeffect.cpp ****     AddParameter(new PotentiometerParameter("K2 Feedback", 0.0f, 0.70f, 0.25f, PotCurve::LIN, KNOB_
  39:effects/slapbackdelayeffect.cpp ****     parameters_.back()->SetDisplayType(DisplayType::SCALED);
