  43:effects/slapbackdelayeffect.cpp ****     AddParameter(new EncoderParameter("E1 Time", 10.0f, 200.0f, 50.0f, 1.0f, ENCODER_1_IDX));
  44:effects/slapbackdelayeffect.cpp ****     parameters_.back()->SetDisplayType(DisplayType::SCALED);
