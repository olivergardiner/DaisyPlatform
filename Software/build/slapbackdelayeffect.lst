  50:effects/slapbackdelayeffect.cpp **** void SlapbackDelayEffect::Process(float* in, float* out, size_t size) {
  51:effects/slapbackdelayeffect.cpp ****     if (!enabled_) {
  52:effects/slapbackdelayeffect.cpp ****         // Bypass - pass through dry signal
  53:effects/slapbackdelayeffect.cpp ****         for (size_t i = 0; i < size; i++) {
  54:effects/slapbackdelayeffect.cpp ****             out[i] = in[i];
  55:effects/slapbackdelayeffect.cpp ****         }
  56:effects/slapbackdelayeffect.cpp ****         return;
  57:effects/slapbackdelayeffect.cpp ****     }
  58:effects/slapbackdelayeffect.cpp ****     
  59:effects/slapbackdelayeffect.cpp ****     // Get parameters
  60:effects/slapbackdelayeffect.cpp ****     float mix = parameters_.size() > 0 ? parameters_[0]->GetValue() : 0.5f;
  61:effects/slapbackdelayeffect.cpp ****     float feedback = parameters_.size() > 1 ? parameters_[1]->GetValue() : 0.25f;
  62:effects/slapbackdelayeffect.cpp ****     
  63:effects/slapbackdelayeffect.cpp ****     // Process with wet/dry blend
  64:effects/slapbackdelayeffect.cpp ****     for (size_t i = 0; i < size; i++) {
  65:effects/slapbackdelayeffect.cpp ****         float delayed = slapbackDelayL_.Read();
  66:effects/slapbackdelayeffect.cpp ****         slapbackDelayL_.Write(in[i] + delayed * feedback);
  67:effects/slapbackdelayeffect.cpp ****         
  68:effects/slapbackdelayeffect.cpp ****         out[i] = wetOnly_ ? (delayed * mix) : (in[i] + delayed * mix);
  69:effects/slapbackdelayeffect.cpp ****     }
  70:effects/slapbackdelayeffect.cpp **** }
  71:effects/slapbackdelayeffect.cpp **** 
  72:effects/slapbackdelayeffect.cpp **** void SlapbackDelayEffect::ProcessStereo(float* inL, float* inR, float* outL, float* outR, size_t si
  73:effects/slapbackdelayeffect.cpp ****     if (!enabled_) {
  74:effects/slapbackdelayeffect.cpp ****         // Bypass - pass through dry signal
  75:effects/slapbackdelayeffect.cpp ****         for (size_t i = 0; i < size; i++) {
  76:effects/slapbackdelayeffect.cpp ****             outL[i] = inL[i];
  77:effects/slapbackdelayeffect.cpp ****             outR[i] = inR[i];
  78:effects/slapbackdelayeffect.cpp ****         }
  79:effects/slapbackdelayeffect.cpp ****         return;
  80:effects/slapbackdelayeffect.cpp ****     }
  81:effects/slapbackdelayeffect.cpp ****     
  82:effects/slapbackdelayeffect.cpp ****     // Get parameters
  83:effects/slapbackdelayeffect.cpp ****     float mix = parameters_.size() > 0 ? parameters_[0]->GetValue() : 0.5f;
  84:effects/slapbackdelayeffect.cpp ****     float feedback = parameters_.size() > 1 ? parameters_[1]->GetValue() : 0.25f;
  85:effects/slapbackdelayeffect.cpp ****     
  86:effects/slapbackdelayeffect.cpp ****     // Process stereo signal with independent delays
  87:effects/slapbackdelayeffect.cpp ****     for (size_t i = 0; i < size; i++) {
  88:effects/slapbackdelayeffect.cpp ****         float delayedL = slapbackDelayL_.Read();
  89:effects/slapbackdelayeffect.cpp ****         float delayedR = slapbackDelayR_.Read();
  90:effects/slapbackdelayeffect.cpp ****         
  91:effects/slapbackdelayeffect.cpp ****         slapbackDelayL_.Write(inL[i] + delayedL * feedback);
  92:effects/slapbackdelayeffect.cpp ****         slapbackDelayR_.Write(inR[i] + delayedR * feedback);
  93:effects/slapbackdelayeffect.cpp ****         
  94:effects/slapbackdelayeffect.cpp ****         outL[i] = wetOnly_ ? (delayedL * mix) : (inL[i] + delayedL * mix);
  95:effects/slapbackdelayeffect.cpp ****         outR[i] = wetOnly_ ? (delayedR * mix) : (inR[i] + delayedR * mix);
  96:effects/slapbackdelayeffect.cpp ****     }
