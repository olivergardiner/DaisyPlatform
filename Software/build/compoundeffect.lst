 147:effects/compoundeffect.cpp ****         for (Effect* effect : effects_) {
 148:effects/compoundeffect.cpp ****             if (effect) {
 149:effects/compoundeffect.cpp ****                 effect->ProcessStereo(inL, inR, tempBufferL_, tempBufferR_, size);
 150:effects/compoundeffect.cpp ****                 
