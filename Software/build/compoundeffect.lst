  99:effects/compoundeffect.cpp **** void CompoundEffect::ProcessStereo(float* inL, float* inR, float* outL, float* outR, size_t size) {
 100:effects/compoundeffect.cpp ****     if (!enabled_ || effects_.empty()) {
 101:effects/compoundeffect.cpp ****         // Bypass - pass through dry signal
 102:effects/compoundeffect.cpp ****         std::memcpy(outL, inL, size * sizeof(float));
 103:effects/compoundeffect.cpp ****         std::memcpy(outR, inR, size * sizeof(float));
 104:effects/compoundeffect.cpp ****         return;
 105:effects/compoundeffect.cpp ****     }
 106:effects/compoundeffect.cpp ****     
 107:effects/compoundeffect.cpp ****     // Reallocate buffers if needed
 108:effects/compoundeffect.cpp ****     if (size > bufferSize_) {
 109:effects/compoundeffect.cpp ****         if (tempBufferL_) delete[] tempBufferL_;
 110:effects/compoundeffect.cpp ****         if (tempBufferR_) delete[] tempBufferR_;
 111:effects/compoundeffect.cpp ****         bufferSize_ = size;
 112:effects/compoundeffect.cpp ****         tempBufferL_ = new float[bufferSize_];
 113:effects/compoundeffect.cpp ****         tempBufferR_ = new float[bufferSize_];
 114:effects/compoundeffect.cpp ****     }
 115:effects/compoundeffect.cpp ****     
 116:effects/compoundeffect.cpp ****     if (routingMode_ == RoutingMode::SERIES) {
 117:effects/compoundeffect.cpp ****         // Series processing: output of one effect feeds into next
 118:effects/compoundeffect.cpp ****         // First effect processes input
 119:effects/compoundeffect.cpp ****         if (effects_[0]) {
 120:effects/compoundeffect.cpp ****             effects_[0]->ProcessStereo(inL, inR, outL, outR, size);
 121:effects/compoundeffect.cpp ****         }
 122:effects/compoundeffect.cpp ****         
 123:effects/compoundeffect.cpp ****         // Subsequent effects use temp buffer for ping-pong processing
 124:effects/compoundeffect.cpp ****         for (size_t i = 1; i < effects_.size(); i++) {
 125:effects/compoundeffect.cpp ****             if (effects_[i]) {
 126:effects/compoundeffect.cpp ****                 // Copy current output to temp buffers
 127:effects/compoundeffect.cpp ****                 std::memcpy(tempBufferL_, outL, size * sizeof(float));
 128:effects/compoundeffect.cpp ****                 std::memcpy(tempBufferR_, outR, size * sizeof(float));
 129:effects/compoundeffect.cpp ****                 // Process temp buffers to output
 130:effects/compoundeffect.cpp ****                 effects_[i]->ProcessStereo(tempBufferL_, tempBufferR_, outL, outR, size);
 131:effects/compoundeffect.cpp ****             }
 132:effects/compoundeffect.cpp ****         }
 133:effects/compoundeffect.cpp ****     } else {
 134:effects/compoundeffect.cpp ****         // Parallel processing: all effects process same input, outputs are mixed
 135:effects/compoundeffect.cpp ****         // Clear output buffers
 136:effects/compoundeffect.cpp ****         std::memset(outL, 0, size * sizeof(float));
 137:effects/compoundeffect.cpp ****         std::memset(outR, 0, size * sizeof(float));
 138:effects/compoundeffect.cpp ****         
 139:effects/compoundeffect.cpp ****         // Add clean signal if enabled
 140:effects/compoundeffect.cpp ****         if (passClean_) {
 141:effects/compoundeffect.cpp ****             std::memcpy(outL, inL, size * sizeof(float));
 142:effects/compoundeffect.cpp ****             std::memcpy(outR, inR, size * sizeof(float));
 143:effects/compoundeffect.cpp ****         }
