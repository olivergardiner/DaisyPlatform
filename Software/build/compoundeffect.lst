  51:effects/compoundeffect.cpp **** void CompoundEffect::Process(float* in, float* out, size_t size) {
  52:effects/compoundeffect.cpp ****     if (!enabled_ || effects_.empty()) {
  53:effects/compoundeffect.cpp ****         // Bypass - pass through dry signal
  54:effects/compoundeffect.cpp ****         std::memcpy(out, in, size * sizeof(float));
  55:effects/compoundeffect.cpp ****         return;
  56:effects/compoundeffect.cpp ****     }
  57:effects/compoundeffect.cpp ****     
  58:effects/compoundeffect.cpp ****     if (routingMode_ == RoutingMode::SERIES) {
  59:effects/compoundeffect.cpp ****         // Series processing: output of one effect feeds into next
  60:effects/compoundeffect.cpp ****         // First effect processes input
  61:effects/compoundeffect.cpp ****         if (effects_[0]) {
  62:effects/compoundeffect.cpp ****             effects_[0]->Process(in, out, size);
  63:effects/compoundeffect.cpp ****         }
  64:effects/compoundeffect.cpp ****         
  65:effects/compoundeffect.cpp ****         // Subsequent effects use temp buffer for ping-pong processing
  66:effects/compoundeffect.cpp ****         for (size_t i = 1; i < effects_.size(); i++) {
  67:effects/compoundeffect.cpp ****             if (effects_[i]) {
  68:effects/compoundeffect.cpp ****                 // Copy current output to temp buffer
  69:effects/compoundeffect.cpp ****                 std::memcpy(tempBufferL_, out, size * sizeof(float));
  70:effects/compoundeffect.cpp ****                 // Process temp buffer to output
  71:effects/compoundeffect.cpp ****                 effects_[i]->Process(tempBufferL_, out, size);
  72:effects/compoundeffect.cpp ****             }
  73:effects/compoundeffect.cpp ****         }
  74:effects/compoundeffect.cpp ****     } else {
  75:effects/compoundeffect.cpp ****         // Parallel processing: all effects process same input, outputs are mixed
  76:effects/compoundeffect.cpp ****         // Clear output buffer
  77:effects/compoundeffect.cpp ****         std::memset(out, 0, size * sizeof(float));
  78:effects/compoundeffect.cpp ****         
  79:effects/compoundeffect.cpp ****         // Add clean signal if enabled
  80:effects/compoundeffect.cpp ****         if (passClean_) {
  81:effects/compoundeffect.cpp ****             std::memcpy(out, in, size * sizeof(float));
  82:effects/compoundeffect.cpp ****         }
  83:effects/compoundeffect.cpp ****         
  84:effects/compoundeffect.cpp ****         // Process each effect and accumulate
  85:effects/compoundeffect.cpp ****         float gain = scaleParallel_ ? (1.0f / static_cast<float>(effects_.size())) : 1.0f;
  86:effects/compoundeffect.cpp ****         for (Effect* effect : effects_) {
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccNpIiVg.s 			page 3


  87:effects/compoundeffect.cpp ****             if (effect) {
  88:effects/compoundeffect.cpp ****                 effect->Process(in, tempBufferL_, size);
  89:effects/compoundeffect.cpp ****                 
  90:effects/compoundeffect.cpp ****                 // Mix into output
  91:effects/compoundeffect.cpp ****                 for (size_t i = 0; i < size; i++) {
  92:effects/compoundeffect.cpp ****                     out[i] += tempBufferL_[i] * gain;
  93:effects/compoundeffect.cpp ****                 }
  94:effects/compoundeffect.cpp ****             }
  95:effects/compoundeffect.cpp ****         }
  96:effects/compoundeffect.cpp ****     }
  97:effects/compoundeffect.cpp **** }
