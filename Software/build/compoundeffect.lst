  35:effects/compoundeffect.cpp **** void CompoundEffect::Init(float sampleRate) {
  36:effects/compoundeffect.cpp ****     sampleRate_ = sampleRate;
  37:effects/compoundeffect.cpp ****     
  38:effects/compoundeffect.cpp ****     // Initialize all child effects
  39:effects/compoundeffect.cpp ****     for (Effect* effect : effects_) {
  40:effects/compoundeffect.cpp ****         if (effect) {
  41:effects/compoundeffect.cpp ****             effect->Init(sampleRate);
  42:effects/compoundeffect.cpp ****         }
  43:effects/compoundeffect.cpp ****     }
  44:effects/compoundeffect.cpp ****     
  45:effects/compoundeffect.cpp ****     // Allocate temporary buffers (assuming max 128 samples per block)
  46:effects/compoundeffect.cpp ****     bufferSize_ = 128;
  47:effects/compoundeffect.cpp ****     tempBufferL_ = new float[bufferSize_];
  48:effects/compoundeffect.cpp ****     tempBufferR_ = new float[bufferSize_];
  49:effects/compoundeffect.cpp **** }
