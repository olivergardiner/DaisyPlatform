  71:effects/flyeffect.cpp ****         // DelayEffect tempo mode toggle is at index 4
  72:effects/flyeffect.cpp ****         EffectParameter* tempoModeParam = delayEffect_->GetParameter(4);
  73:effects/flyeffect.cpp ****         if (tempoModeParam && tempoModeParam->GetType() == ParameterType::TOGGLE) {
  74:effects/flyeffect.cpp ****             ToggleParameter* toggleParam = static_cast<ToggleParameter*>(tempoModeParam);
  75:effects/flyeffect.cpp ****             // Set to tempo mode (true)
