  54:effects/flyeffect.cpp ****     tempoModeParamIndex_ = 6;
  55:effects/flyeffect.cpp ****     
  56:effects/flyeffect.cpp ****     // Set subdivision parameter on delay effect to 3/16ths (index 2)
  57:effects/flyeffect.cpp ****     // The delay effect has its own parameter indices, so we need to access it directly
  58:effects/flyeffect.cpp ****     if (delayEffect_ && delayEffect_->GetParameterCount() >= 3) {
  59:effects/flyeffect.cpp ****         // DelayEffect has: [0]=Mix, [1]=Feedback, [2]=Subdivision, [3]=Time, [4]=TempoToggle
  60:effects/flyeffect.cpp ****         // Set subdivision to index 2 (3/16ths)
  61:effects/flyeffect.cpp ****         EffectParameter* subdivParam = delayEffect_->GetParameter(2);
  62:effects/flyeffect.cpp ****         if (subdivParam && subdivParam->GetType() == ParameterType::POTENTIOMETER) {
  63:effects/flyeffect.cpp ****             PotentiometerParameter* potParam = static_cast<PotentiometerParameter*>(subdivParam);
  64:effects/flyeffect.cpp ****             // Set to 2.0 out of 6.0 max = 33.33% normalized value
  65:effects/flyeffect.cpp ****             potParam->SetNormalizedValueWithCurve(2.0f / 6.0f);
