  92:effects/flyeffect.cpp **** void FlyEffect::Update() {
  93:effects/flyeffect.cpp ****     TimeParameter* flyTimeParam = nullptr;
  94:effects/flyeffect.cpp ****     ToggleParameter* flyTempoModeParam = nullptr;
