 100:effects/flyeffect.cpp ****         flyTempoModeParam = static_cast<ToggleParameter*>(GetParameter(tempoModeParamIndex_));
 101:effects/flyeffect.cpp ****     }
 102:effects/flyeffect.cpp **** 
 103:effects/flyeffect.cpp ****     if (GetParameterCount() >= 7) {
 104:effects/flyeffect.cpp ****         float wahMix = GetParameter(0)->GetValue();
 105:effects/flyeffect.cpp ****         float sweepHz = GetParameter(1)->GetValue();
 106:effects/flyeffect.cpp ****         float sensitivity = GetParameter(2)->GetValue();
 107:effects/flyeffect.cpp ****         float delayMix = GetParameter(3)->GetValue();
 108:effects/flyeffect.cpp ****         float delayFeedback = GetParameter(4)->GetValue();
 109:effects/flyeffect.cpp **** 
 110:effects/flyeffect.cpp ****         // Shape wah for the "Fly" pulse while leaving gain staging to external drive.
 111:effects/flyeffect.cpp ****         if (autowahV2Effect_ && autowahV2Effect_->GetParameterCount() >= 8) {
 112:effects/flyeffect.cpp ****             autowahV2Effect_->GetParameter(0)->SetValue(wahMix);
 113:effects/flyeffect.cpp ****             autowahV2Effect_->GetParameter(1)->SetValue(0.90f);
 114:effects/flyeffect.cpp ****             autowahV2Effect_->GetParameter(2)->SetValue(sweepHz);
 115:effects/flyeffect.cpp ****             autowahV2Effect_->GetParameter(3)->SetValue(0.07f);
 116:effects/flyeffect.cpp ****             autowahV2Effect_->GetParameter(4)->SetValue(0.05f);
 117:effects/flyeffect.cpp ****             autowahV2Effect_->GetParameter(5)->SetValue(sensitivity);
 118:effects/flyeffect.cpp ****             autowahV2Effect_->GetParameter(6)->SetValue(0.0f);
 119:effects/flyeffect.cpp ****             autowahV2Effect_->GetParameter(7)->SetValue(1.0f);
 120:effects/flyeffect.cpp ****         }
 121:effects/flyeffect.cpp **** 
 122:effects/flyeffect.cpp ****         if (delayEffect_ && delayEffect_->GetParameterCount() >= 5) {
 123:effects/flyeffect.cpp ****             // Keep repeats audible even when front-panel knobs are near minimum.
 124:effects/flyeffect.cpp ****             float mappedMix = 0.28f + (delayMix * 0.52f);
 125:effects/flyeffect.cpp ****             float mappedFeedback = 0.16f + (delayFeedback * 0.42f);
 126:effects/flyeffect.cpp **** 
 127:effects/flyeffect.cpp ****             delayEffect_->GetParameter(0)->SetValue(mappedMix);
 128:effects/flyeffect.cpp ****             delayEffect_->GetParameter(1)->SetValue(mappedFeedback);
 129:effects/flyeffect.cpp ****             delayEffect_->GetParameter(2)->SetValue(2.0f); // 3/16 subdivision
 130:effects/flyeffect.cpp **** 
 131:effects/flyeffect.cpp ****             if (flyTimeParam && delayEffect_->GetParameterCount() >= 4) {
 132:effects/flyeffect.cpp ****                 EffectParameter* delayTimeParam = delayEffect_->GetParameter(3);
 133:effects/flyeffect.cpp ****                 if (delayTimeParam && delayTimeParam->GetType() == ParameterType::ENCODER) {
 134:effects/flyeffect.cpp ****                     TimeParameter* childTime = static_cast<TimeParameter*>(delayTimeParam);
 135:effects/flyeffect.cpp ****                     childTime->SetValue(flyTimeParam->GetValueAsMs());
 136:effects/flyeffect.cpp ****                 }
 137:effects/flyeffect.cpp ****             }
 138:effects/flyeffect.cpp **** 
 139:effects/flyeffect.cpp ****             if (flyTempoModeParam && delayEffect_->GetParameterCount() >= 5) {
