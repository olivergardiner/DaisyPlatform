 149:effects/flyeffect.cpp ****     // Handle tempo mode toggle from E1 Button
 150:effects/flyeffect.cpp ****     if (flyTimeParam && flyTempoModeParam) {
 151:effects/flyeffect.cpp ****         TimeParameter* timeParam = flyTimeParam;
 152:effects/flyeffect.cpp ****         ToggleParameter* tempoModeParam = flyTempoModeParam;
 153:effects/flyeffect.cpp ****         
 154:effects/flyeffect.cpp ****         // Update TimeParameter's display mode based on toggle state
 155:effects/flyeffect.cpp ****         TimeDisplayMode newMode = tempoModeParam->GetState() ? TimeDisplayMode::TEMPO_BPM : TimeDis
 156:effects/flyeffect.cpp ****         if (timeParam->GetDisplayMode() != newMode) {
 157:effects/flyeffect.cpp ****             timeParam->SetDisplayMode(newMode);
 158:effects/flyeffect.cpp ****             // Ensure the visible E1 parameter display updates when mode toggles.
 159:effects/flyeffect.cpp ****             RequestParameterDisplayUpdate(timeParamIndex_);
 160:effects/flyeffect.cpp ****         }
 161:effects/flyeffect.cpp ****         
 162:effects/flyeffect.cpp ****         // Convert BPM to Hz for SetTempo (SetTempo expects Hz)
 163:effects/flyeffect.cpp ****         float bpm = timeParam->GetValueAsBPM();
 164:effects/flyeffect.cpp ****         tempoHz = bpm / 60.0f;
 165:effects/flyeffect.cpp ****     }
 166:effects/flyeffect.cpp **** 
 167:effects/flyeffect.cpp ****     SetTempo(tempoHz);
 168:effects/flyeffect.cpp ****     
 169:effects/flyeffect.cpp ****     // Call parent Update to update child effects
