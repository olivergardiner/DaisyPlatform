  41:effects/phasereffect.cpp ****             return std::sinf(2.0f * kPi * phase);
  42:effects/phasereffect.cpp ****     }
  43:effects/phasereffect.cpp **** }
  44:effects/phasereffect.cpp **** 
  45:effects/phasereffect.cpp **** static inline float ComputeAllpassCoeff(float freqHz, float sampleRate) {
  46:effects/phasereffect.cpp ****     float clampedFreq = Clamp(freqHz, 20.0f, 0.45f * sampleRate);
  47:effects/phasereffect.cpp ****     float g = std::tanf(kPi * clampedFreq / sampleRate);
  48:effects/phasereffect.cpp ****     float a = (1.0f - g) / (1.0f + g);
  49:effects/phasereffect.cpp ****     return Clamp(a, -0.98f, 0.98f);
  50:effects/phasereffect.cpp **** }
  51:effects/phasereffect.cpp **** 
