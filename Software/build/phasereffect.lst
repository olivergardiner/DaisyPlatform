  90:effects/phasereffect.cpp **** void PhaserEffect::Process(float* in, float* out, size_t size) {
  91:effects/phasereffect.cpp ****     if (!enabled_) {
  92:effects/phasereffect.cpp ****         for (size_t i = 0; i < size; ++i) {
  93:effects/phasereffect.cpp ****             out[i] = in[i];
  94:effects/phasereffect.cpp ****         }
  95:effects/phasereffect.cpp ****         return;
  96:effects/phasereffect.cpp ****     }
  97:effects/phasereffect.cpp **** 
  98:effects/phasereffect.cpp ****     float mix = Clamp(parameters_[0]->GetValue(), 0.0f, 1.0f);
  99:effects/phasereffect.cpp ****     float depth = Clamp(parameters_[1]->GetValue(), 0.0f, 1.0f);
 100:effects/phasereffect.cpp ****     float rateHz = parameters_[2]->GetValue();
 101:effects/phasereffect.cpp ****     float feedback = parameters_[3]->GetValue();
 102:effects/phasereffect.cpp ****     float centerHz = parameters_[4]->GetValue();
 103:effects/phasereffect.cpp ****     int stages = static_cast<int>(Clamp(parameters_[5]->GetValue(), 2.0f, 8.0f));
 104:effects/phasereffect.cpp ****     int waveShape = static_cast<int>(parameters_[6]->GetValue());
 105:effects/phasereffect.cpp **** 
 106:effects/phasereffect.cpp ****     if (stages < 2) {
 107:effects/phasereffect.cpp ****         stages = 2;
 108:effects/phasereffect.cpp ****     }
 109:effects/phasereffect.cpp **** 
 110:effects/phasereffect.cpp ****     float phaseInc = rateHz / sampleRate_;
 111:effects/phasereffect.cpp **** 
 112:effects/phasereffect.cpp ****     for (size_t i = 0; i < size; ++i) {
 113:effects/phasereffect.cpp ****         float lfo = LfoValue(lfoPhaseL_, waveShape);
 114:effects/phasereffect.cpp ****         float mod = 0.5f * (lfo + 1.0f);
 115:effects/phasereffect.cpp **** 
 116:effects/phasereffect.cpp ****         float minHz = centerHz * (1.0f - 0.85f * depth);
 117:effects/phasereffect.cpp ****         float maxHz = centerHz * (1.0f + 2.5f * depth);
 118:effects/phasereffect.cpp ****         minHz = Clamp(minHz, 40.0f, 6000.0f);
 119:effects/phasereffect.cpp ****         maxHz = Clamp(maxHz, minHz + 1.0f, 8000.0f);
 120:effects/phasereffect.cpp **** 
 121:effects/phasereffect.cpp ****         float sweepHz = minHz + (maxHz - minHz) * mod;
 122:effects/phasereffect.cpp **** 
 123:effects/phasereffect.cpp ****         float x = in[i] + feedbackStateL_ * feedback;
 124:effects/phasereffect.cpp ****         float y = x;
 125:effects/phasereffect.cpp **** 
 126:effects/phasereffect.cpp ****         for (int s = 0; s < stages; ++s) {
 127:effects/phasereffect.cpp ****             float spread = static_cast<float>(s + 1) / static_cast<float>(stages);
 128:effects/phasereffect.cpp ****             float stageHz = sweepHz * (0.65f + spread * 0.9f);
 129:effects/phasereffect.cpp ****             stagesL_[s].a = ComputeAllpassCoeff(stageHz, sampleRate_);
 130:effects/phasereffect.cpp ****             y = stagesL_[s].Process(y);
 131:effects/phasereffect.cpp ****         }
 132:effects/phasereffect.cpp **** 
 133:effects/phasereffect.cpp ****         feedbackStateL_ = y;
 134:effects/phasereffect.cpp ****         out[i] = in[i] * (1.0f - mix) + y * mix;
 135:effects/phasereffect.cpp **** 
 136:effects/phasereffect.cpp ****         lfoPhaseL_ = WrapPhase(lfoPhaseL_ + phaseInc);
 137:effects/phasereffect.cpp ****     }
 138:effects/phasereffect.cpp **** }
