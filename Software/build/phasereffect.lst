  10:effects/phasereffect.cpp **** namespace {
  11:effects/phasereffect.cpp **** 
  12:effects/phasereffect.cpp **** static constexpr float kPi = 3.14159265358979323846f;
  13:effects/phasereffect.cpp **** 
  14:effects/phasereffect.cpp **** static inline float Clamp(float x, float lo, float hi) {
  15:effects/phasereffect.cpp ****     return std::max(lo, std::min(x, hi));
  16:effects/phasereffect.cpp **** }
  17:effects/phasereffect.cpp **** 
  18:effects/phasereffect.cpp **** static inline float WrapPhase(float phase) {
  19:effects/phasereffect.cpp ****     while (phase >= 1.0f) {
  20:effects/phasereffect.cpp ****         phase -= 1.0f;
  21:effects/phasereffect.cpp ****     }
  22:effects/phasereffect.cpp ****     while (phase < 0.0f) {
  23:effects/phasereffect.cpp ****         phase += 1.0f;
  24:effects/phasereffect.cpp ****     }
  25:effects/phasereffect.cpp ****     return phase;
  26:effects/phasereffect.cpp **** }
  27:effects/phasereffect.cpp **** 
  28:effects/phasereffect.cpp **** static inline float LfoValue(float phase, int shape) {
  29:effects/phasereffect.cpp ****     phase = WrapPhase(phase);
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccAPLW26.s 			page 2


  30:effects/phasereffect.cpp ****     switch (shape) {
  31:effects/phasereffect.cpp ****         case 1: {
  32:effects/phasereffect.cpp ****             float t = phase * 2.0f;
  33:effects/phasereffect.cpp ****             return (t < 1.0f) ? (-1.0f + 2.0f * t) : (3.0f - 2.0f * t);
  34:effects/phasereffect.cpp ****         }
  35:effects/phasereffect.cpp ****         case 2:
