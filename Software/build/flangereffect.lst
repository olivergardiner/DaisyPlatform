  42:effects/flangereffect.cpp ****     }
  43:effects/flangereffect.cpp **** }
  44:effects/flangereffect.cpp **** 
  45:effects/flangereffect.cpp **** static inline float CubicInterpolate(float y0, float y1, float y2, float y3, float t) {
  46:effects/flangereffect.cpp ****     float a0 = y3 - y2 - y0 + y1;
  47:effects/flangereffect.cpp ****     float a1 = y0 - y1 - a0;
  48:effects/flangereffect.cpp ****     float a2 = y2 - y0;
  49:effects/flangereffect.cpp ****     float a3 = y1;
  50:effects/flangereffect.cpp ****     return ((a0 * t + a1) * t + a2) * t + a3;
  51:effects/flangereffect.cpp **** }
  52:effects/flangereffect.cpp **** 
  53:effects/flangereffect.cpp **** static inline float ReadDelayInterpolated(const float* buffer, int size, float readPos) {
  54:effects/flangereffect.cpp ****     while (readPos < 0.0f) {
  55:effects/flangereffect.cpp ****         readPos += static_cast<float>(size);
  56:effects/flangereffect.cpp ****     }
  57:effects/flangereffect.cpp ****     while (readPos >= static_cast<float>(size)) {
  58:effects/flangereffect.cpp ****         readPos -= static_cast<float>(size);
  59:effects/flangereffect.cpp ****     }
  60:effects/flangereffect.cpp **** 
  61:effects/flangereffect.cpp ****     int x1 = static_cast<int>(readPos);
  62:effects/flangereffect.cpp ****     float frac = readPos - static_cast<float>(x1);
  63:effects/flangereffect.cpp **** 
  64:effects/flangereffect.cpp ****     int x0 = (x1 - 1 + size) % size;
  65:effects/flangereffect.cpp ****     int x2 = (x1 + 1) % size;
  66:effects/flangereffect.cpp ****     int x3 = (x1 + 2) % size;
  67:effects/flangereffect.cpp **** 
  68:effects/flangereffect.cpp ****     return CubicInterpolate(buffer[x0], buffer[x1], buffer[x2], buffer[x3], frac);
  69:effects/flangereffect.cpp **** }
