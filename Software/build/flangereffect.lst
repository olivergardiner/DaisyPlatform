  30:effects/flangereffect.cpp ****     switch (shape) {
  31:effects/flangereffect.cpp ****         case 1: {
  32:effects/flangereffect.cpp ****             float t = phase * 2.0f;
  33:effects/flangereffect.cpp ****             return (t < 1.0f) ? (-1.0f + 2.0f * t) : (3.0f - 2.0f * t);
  34:effects/flangereffect.cpp ****         }
