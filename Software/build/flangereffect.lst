  16:effects/flangereffect.cpp **** }
  17:effects/flangereffect.cpp **** 
  18:effects/flangereffect.cpp **** static inline float WrapPhase(float phase) {
  19:effects/flangereffect.cpp ****     while (phase >= 1.0f) {
  20:effects/flangereffect.cpp ****         phase -= 1.0f;
  21:effects/flangereffect.cpp ****     }
  22:effects/flangereffect.cpp ****     while (phase < 0.0f) {
  23:effects/flangereffect.cpp ****         phase += 1.0f;
  24:effects/flangereffect.cpp ****     }
  25:effects/flangereffect.cpp ****     return phase;
  26:effects/flangereffect.cpp **** }
  27:effects/flangereffect.cpp **** 
  28:effects/flangereffect.cpp **** static inline float LfoValue(float phase, int shape) {
