 107:effects/flangereffect.cpp **** void FlangerEffect::Process(float* in, float* out, size_t size) {
 108:effects/flangereffect.cpp ****     if (!enabled_) {
 109:effects/flangereffect.cpp ****         for (size_t i = 0; i < size; ++i) {
 110:effects/flangereffect.cpp ****             out[i] = in[i];
 111:effects/flangereffect.cpp ****         }
 112:effects/flangereffect.cpp ****         return;
 113:effects/flangereffect.cpp ****     }
 114:effects/flangereffect.cpp **** 
 115:effects/flangereffect.cpp ****     float mix = Clamp01(parameters_[0]->GetValue());
 116:effects/flangereffect.cpp ****     float depth = Clamp01(parameters_[1]->GetValue());
 117:effects/flangereffect.cpp ****     float rateHz = parameters_[2]->GetValue();
 118:effects/flangereffect.cpp ****     float feedback = parameters_[3]->GetValue();
 119:effects/flangereffect.cpp ****     float manualMs = parameters_[4]->GetValue();
 120:effects/flangereffect.cpp ****     int waveShape = static_cast<int>(parameters_[5]->GetValue());
 121:effects/flangereffect.cpp **** 
 122:effects/flangereffect.cpp ****     float maxSweepMs = 6.0f;
 123:effects/flangereffect.cpp ****     float phaseInc = rateHz / sampleRate_;
 124:effects/flangereffect.cpp **** 
 125:effects/flangereffect.cpp ****     for (size_t i = 0; i < size; ++i) {
 126:effects/flangereffect.cpp ****         float lfo = LfoValue(lfoPhaseL_, waveShape);
 127:effects/flangereffect.cpp ****         float mod = 0.5f * (lfo + 1.0f);
 128:effects/flangereffect.cpp ****         float delayMs = manualMs + depth * maxSweepMs * mod;
 129:effects/flangereffect.cpp ****         float delaySamples = delayMs * sampleRate_ * 0.001f;
 130:effects/flangereffect.cpp **** 
 131:effects/flangereffect.cpp ****         float input = in[i] + feedbackStateL_ * feedback;
 132:effects/flangereffect.cpp ****         delayBufferL_[writeIndex_] = input;
 133:effects/flangereffect.cpp **** 
 134:effects/flangereffect.cpp ****         float readPos = static_cast<float>(writeIndex_) - delaySamples;
 135:effects/flangereffect.cpp ****         float wet = ReadDelayInterpolated(delayBufferL_, kMaxDelaySamples, readPos);
 136:effects/flangereffect.cpp ****         feedbackStateL_ = wet;
 137:effects/flangereffect.cpp **** 
 138:effects/flangereffect.cpp ****         out[i] = in[i] * (1.0f - mix) + wet * mix;
 139:effects/flangereffect.cpp **** 
 140:effects/flangereffect.cpp ****         writeIndex_ = (writeIndex_ + 1) % kMaxDelaySamples;
 141:effects/flangereffect.cpp ****         lfoPhaseL_ = WrapPhase(lfoPhaseL_ + phaseInc);
 142:effects/flangereffect.cpp ****     }
 143:effects/flangereffect.cpp **** }
