  46:dependencies/DaisySP/Source/Utility/dsp.h ****     r = (a > b) ? a : b;
  47:dependencies/DaisySP/Source/Utility/dsp.h **** #endif // __arm__
  48:dependencies/DaisySP/Source/Utility/dsp.h ****     return r;
  49:dependencies/DaisySP/Source/Utility/dsp.h **** }
