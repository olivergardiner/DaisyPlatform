 135:effects/moddelayeffect.cpp **** void ModDelayEffect::ProcessStereo(float* inL, float* inR, float* outL, float* outR, size_t size) {
 136:effects/moddelayeffect.cpp ****     if (!enabled_) {
 137:effects/moddelayeffect.cpp ****         // Bypass - pass through dry signal
 138:effects/moddelayeffect.cpp ****         for (size_t i = 0; i < size; i++) {
 139:effects/moddelayeffect.cpp ****             outL[i] = inL[i];
 140:effects/moddelayeffect.cpp ****             outR[i] = inR[i];
 141:effects/moddelayeffect.cpp ****         }
 142:effects/moddelayeffect.cpp ****         return;
 143:effects/moddelayeffect.cpp ****     }
 144:effects/moddelayeffect.cpp ****     
 145:effects/moddelayeffect.cpp ****     // Get parameters
 146:effects/moddelayeffect.cpp ****     float mix = parameters_.size() > 0 ? parameters_[0]->GetValue() : 0.5f;
 147:effects/moddelayeffect.cpp ****     float feedback = parameters_.size() > 1 ? parameters_[1]->GetValue() : 0.5f;
 148:effects/moddelayeffect.cpp ****     float modDepth = parameters_.size() > 3 ? parameters_[3]->GetValue() : 0.0f;
 149:effects/moddelayeffect.cpp ****     
 150:effects/moddelayeffect.cpp ****     // Use cached effective delay time (updated in Update())
 151:effects/moddelayeffect.cpp ****     float effectiveDelayTime = effectiveDelayTime_;
 152:effects/moddelayeffect.cpp ****     
 153:effects/moddelayeffect.cpp ****     // Optimization: only modulate delay time when modDepth > 0
 154:effects/moddelayeffect.cpp ****     static constexpr float MOD_THRESHOLD = 0.001f; // 0.1% threshold
 155:effects/moddelayeffect.cpp ****     bool hasModulation = modDepth > MOD_THRESHOLD;
 156:effects/moddelayeffect.cpp ****     
 157:effects/moddelayeffect.cpp ****     // Process stereo signal with independent delays and modulation
 158:effects/moddelayeffect.cpp ****     for (size_t i = 0; i < size; i++) {
 159:effects/moddelayeffect.cpp ****         if (hasModulation) {
 160:effects/moddelayeffect.cpp ****             // Apply modulation to delay times (stereo LFOs for wider effect)
 161:effects/moddelayeffect.cpp ****             float lfoValueL = lfoL_.Process();
 162:effects/moddelayeffect.cpp ****             float lfoValueR = lfoR_.Process();
 163:effects/moddelayeffect.cpp ****             
 164:effects/moddelayeffect.cpp ****             float modulatedTimeL = effectiveDelayTime + (lfoValueL * modDepth * 0.001f); // modDept
 165:effects/moddelayeffect.cpp ****             float modulatedTimeR = effectiveDelayTime + (lfoValueR * modDepth * 0.001f);
 166:effects/moddelayeffect.cpp ****             modulatedTimeL = fclamp(modulatedTimeL, 0.001f, 2.0f);
 167:effects/moddelayeffect.cpp ****             modulatedTimeR = fclamp(modulatedTimeR, 0.001f, 2.0f);
 168:effects/moddelayeffect.cpp ****             
 169:effects/moddelayeffect.cpp ****             delayL_.SetDelay(sampleRate_ * modulatedTimeL);
 170:effects/moddelayeffect.cpp ****             delayR_.SetDelay(sampleRate_ * modulatedTimeR);
 171:effects/moddelayeffect.cpp ****         } else {
 172:effects/moddelayeffect.cpp ****             // Skip LFO processing when not modulating
 173:effects/moddelayeffect.cpp ****             lfoL_.Process();
 174:effects/moddelayeffect.cpp ****             lfoR_.Process();
 175:effects/moddelayeffect.cpp ****         }
 176:effects/moddelayeffect.cpp ****         
 177:effects/moddelayeffect.cpp ****         float delayedL = delayL_.Read();
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\cc0hFps9.s 			page 73


 178:effects/moddelayeffect.cpp ****         float delayedR = delayR_.Read();
 179:effects/moddelayeffect.cpp ****         
 180:effects/moddelayeffect.cpp ****         delayL_.Write(inL[i] + delayedL * feedback);
 181:effects/moddelayeffect.cpp ****         delayR_.Write(inR[i] + delayedR * feedback);
 182:effects/moddelayeffect.cpp ****         
 183:effects/moddelayeffect.cpp ****         // Mix in metronome
 184:effects/moddelayeffect.cpp ****         float metronome = ProcessMetronome();
 185:effects/moddelayeffect.cpp ****         
 186:effects/moddelayeffect.cpp ****         outL[i] = wetOnly_ ? (delayedL * mix) : (inL[i] + delayedL * mix);
 187:effects/moddelayeffect.cpp ****         outR[i] = wetOnly_ ? (delayedR * mix) : (inR[i] + delayedR * mix);
 188:effects/moddelayeffect.cpp ****         
 189:effects/moddelayeffect.cpp ****         // Add metronome to both channels
 190:effects/moddelayeffect.cpp ****         outL[i] += metronome;
 191:effects/moddelayeffect.cpp ****         outR[i] += metronome;
 192:effects/moddelayeffect.cpp ****     }
 193:effects/moddelayeffect.cpp **** }
