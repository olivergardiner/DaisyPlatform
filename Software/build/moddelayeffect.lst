  40:dependencies/DaisySP/Source/Utility/dsp.h **** inline float fmax(float a, float b)
  41:dependencies/DaisySP/Source/Utility/dsp.h **** {
  42:dependencies/DaisySP/Source/Utility/dsp.h ****     float r;
  43:dependencies/DaisySP/Source/Utility/dsp.h **** #ifdef __arm__
  44:dependencies/DaisySP/Source/Utility/dsp.h ****     asm("vmaxnm.f32 %[d], %[n], %[m]" : [d] "=t"(r) : [n] "t"(a), [m] "t"(b) :);
