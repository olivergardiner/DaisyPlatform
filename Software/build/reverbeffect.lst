 100:effects/reverbeffect.cpp **** void ReverbEffect::ProcessStereo(float* inL, float* inR, float* outL, float* outR, size_t size) {
 101:effects/reverbeffect.cpp ****     if (!enabled_ || !reverbAllocated_ || !reverb_) {
 102:effects/reverbeffect.cpp ****         for (size_t i = 0; i < size; ++i) {
 103:effects/reverbeffect.cpp ****             outL[i] = inL[i];
 104:effects/reverbeffect.cpp ****             outR[i] = inR[i];
 105:effects/reverbeffect.cpp ****         }
 106:effects/reverbeffect.cpp ****         return;
 107:effects/reverbeffect.cpp ****     }
 108:effects/reverbeffect.cpp **** 
 109:effects/reverbeffect.cpp ****     for (size_t i = 0; i < size; ++i) {
 110:effects/reverbeffect.cpp ****         float wetL = 0.0f;
 111:effects/reverbeffect.cpp ****         float wetR = 0.0f;
 112:effects/reverbeffect.cpp ****         reverb_->Process(inL[i], inR[i], &wetL, &wetR);
 113:effects/reverbeffect.cpp **** 
 114:effects/reverbeffect.cpp ****         outL[i] = inL[i] * (1.0f - mix_) + wetL * mix_;
 115:effects/reverbeffect.cpp ****         outR[i] = inR[i] * (1.0f - mix_) + wetR * mix_;
 116:effects/reverbeffect.cpp ****     }
 117:effects/reverbeffect.cpp **** }
