  32:effects/waheffect.cpp **** void WahEffect::Process(float* in, float* out, size_t size) {
  33:effects/waheffect.cpp ****     if (!enabled_) {
  34:effects/waheffect.cpp ****         // Bypass - pass through dry signal
  35:effects/waheffect.cpp ****         for (size_t i = 0; i < size; i++) {
  36:effects/waheffect.cpp ****             out[i] = in[i];
  37:effects/waheffect.cpp ****         }
