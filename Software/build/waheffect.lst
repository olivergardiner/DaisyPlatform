  43:effects/waheffect.cpp **** 
  44:effects/waheffect.cpp ****     // Process with wet/dry blend
  45:effects/waheffect.cpp ****     for (size_t i = 0; i < size; i++) {
  46:effects/waheffect.cpp ****         filterL_.Process(in[i]);
  47:effects/waheffect.cpp ****         float wet = filterL_.Band();
  48:effects/waheffect.cpp ****         out[i] = in[i] * (1.0f - mix) + wet * mix;
  49:effects/waheffect.cpp ****     }
  50:effects/waheffect.cpp **** }
