  33:effects/phaserlegacyeffect.cpp ****     if (!enabled_) {
  34:effects/phaserlegacyeffect.cpp ****         // Bypass - pass through dry signal
  35:effects/phaserlegacyeffect.cpp ****         for (size_t i = 0; i < size; i++) {
  36:effects/phaserlegacyeffect.cpp ****             out[i] = in[i];
  37:effects/phaserlegacyeffect.cpp ****         }
