 280:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Move the layer to a new position (x, y)
 281:dependencies/DaisySeedGFX2/cDisplay.cpp **** DAD_GFX_ERROR cLayerBase::moveLayer(uint16_t x, uint16_t y){
 282:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Check if the new position is within screen boundaries
 283:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if(x >= m_pDisplay->getWith()) x = m_pDisplay->getWith()-1;
 284:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if(y >= m_pDisplay->getHeight()) y = m_pDisplay->getHeight()-1;
 285:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 286:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Invalidate the current position to erase the layer
 287:dependencies/DaisySeedGFX2/cDisplay.cpp ****     m_pDisplay->invalidateRect(m_X, m_Y, m_X + m_Width -1, m_Y + m_Height -1);
 288:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 289:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Update layer position
 290:dependencies/DaisySeedGFX2/cDisplay.cpp ****     m_X = x;
 291:dependencies/DaisySeedGFX2/cDisplay.cpp ****     m_Y = y;
 292:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 293:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Invalidate the new position to redraw the layer
 294:dependencies/DaisySeedGFX2/cDisplay.cpp ****     m_pDisplay->invalidateRect(m_X, m_Y, m_X + m_Width-1, m_Y + m_Height-1);
 295:dependencies/DaisySeedGFX2/cDisplay.cpp ****     return DAD_GFX_ERROR::OK;  // Operation successful
 296:dependencies/DaisySeedGFX2/cDisplay.cpp **** }
