 674:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Send the blocks currently in the FIFO using DMA
 675:dependencies/DaisySeedGFX2/cDisplay.cpp **** // This function initiates the DMA transmission process for blocks in the FIFO. 
 676:dependencies/DaisySeedGFX2/cDisplay.cpp **** // The DMA controller handles the transfer of display data to the screen.
 677:dependencies/DaisySeedGFX2/cDisplay.cpp **** //
 678:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Returns:
 679:dependencies/DaisySeedGFX2/cDisplay.cpp **** //   true if the transmission started successfully, false otherwise
 680:dependencies/DaisySeedGFX2/cDisplay.cpp **** bool cDisplay::sendDMA() {
 681:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Disable interrupts to safely check and modify shared resources
 682:dependencies/DaisySeedGFX2/cDisplay.cpp ****     __disable_irq();
 683:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 684:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // If the FIFO is empty or a transmission is already in progress, re-enable
 685:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // interrupts and return false
 686:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if ((m_FIFO_NbElements == 0) || (m_Busy == true)) {
 687:dependencies/DaisySeedGFX2/cDisplay.cpp ****         __enable_irq();
 688:dependencies/DaisySeedGFX2/cDisplay.cpp ****         return false;
 689:dependencies/DaisySeedGFX2/cDisplay.cpp ****     }
 690:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 691:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Re-enable interrupts after the safety check
 692:dependencies/DaisySeedGFX2/cDisplay.cpp ****     __enable_irq();
 693:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 694:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Mark the display as busy to indicate that a transmission is in progress
 695:dependencies/DaisySeedGFX2/cDisplay.cpp ****     m_Busy = true;
 696:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 697:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Initiate the transmission of the first block in the FIFO
 698:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // CASET (Column Address Set) command is sent first
 699:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // - The callback function `sendCASETDMAData` will handle subsequent steps
 700:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // - `this` provides context to the callback for handling other DMA stages
 701:dependencies/DaisySeedGFX2/cDisplay.cpp ****      __disable_irq();
 702:dependencies/DaisySeedGFX2/cDisplay.cpp ****     SendDMACommand(&m_pFIFO->m_CmdCASET[m_FIFO_out].m_Commande, 
 703:dependencies/DaisySeedGFX2/cDisplay.cpp ****                    cDisplay::sendCASETDMAData, 
 704:dependencies/DaisySeedGFX2/cDisplay.cpp ****                    this);
 705:dependencies/DaisySeedGFX2/cDisplay.cpp ****     __enable_irq();
 706:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Return true to indicate that transmission was successfully started
 707:dependencies/DaisySeedGFX2/cDisplay.cpp ****     return true;
 708:dependencies/DaisySeedGFX2/cDisplay.cpp **** }
 709:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
