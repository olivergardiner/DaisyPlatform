 550:dependencies/DaisySeedGFX2/cDisplay.cpp ****                 memset((void*)m_pDitryBlocFrame, 0x00, sizeof(sColor[BLOC_WIDTH][BLOC_HEIGHT]));
 551:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
