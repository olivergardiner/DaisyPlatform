  82:dependencies/DaisySeedGFX2/cDisplay.h ****     void setData(uint16_t x, uint16_t dx) {
  83:dependencies/DaisySeedGFX2/cDisplay.h ****         #if XSCREEN_OFFSET != 0
  84:dependencies/DaisySeedGFX2/cDisplay.h ****             x += XSCREEN_OFFSET;
  85:dependencies/DaisySeedGFX2/cDisplay.h ****             dx += XSCREEN_OFFSET;
