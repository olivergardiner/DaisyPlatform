  86:dependencies/DaisySeedGFX2/cDisplay.h ****         #endif
  87:dependencies/DaisySeedGFX2/cDisplay.h ****         m_Data[0] = x >> 8;       // High byte of the starting column
  88:dependencies/DaisySeedGFX2/cDisplay.h ****         m_Data[1] = x & 0xFF;     // Low byte of the starting column
  89:dependencies/DaisySeedGFX2/cDisplay.h ****         m_Data[2] = dx >> 8;      // High byte of the ending column
  90:dependencies/DaisySeedGFX2/cDisplay.h ****         m_Data[3] = dx & 0xFF;    // Low byte of the ending column
