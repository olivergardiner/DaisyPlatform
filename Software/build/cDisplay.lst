 470:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Blends two rectangular blocks of pixels using alpha compositing.
 471:dependencies/DaisySeedGFX2/cDisplay.cpp **** // 
 472:dependencies/DaisySeedGFX2/cDisplay.cpp **** // This function processes two pixel sources (`pSource1` and `pSource2`) over a 
 473:dependencies/DaisySeedGFX2/cDisplay.cpp **** // specified width and height, blending them and storing the result in `pDest`.
 474:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Alpha transparency is managed, handling fully opaque, semi-transparent, and
 475:dependencies/DaisySeedGFX2/cDisplay.cpp **** // transparent cases. Row padding for each buffer is accounted for using offsets.
 476:dependencies/DaisySeedGFX2/cDisplay.cpp **** // 
 477:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Parameters:
 478:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - OutputOffset: Offset to skip at the end of each row in the destination buffer.
 479:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - InputOffset1: Offset to skip at the end of each row in the first source buffer.
 480:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - InputOffset2: Offset to skip at the end of each row in the second source buffer.
 481:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - pSource1: Pointer to the first source pixel data (foreground).
 482:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - pSource2: Pointer to the second source pixel data (background).
 483:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - pDest: Pointer to the destination pixel data.
 484:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - Width: Width of the block to process, in pixels.
 485:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - Height: Height of the block to process, in pixels.
 486:dependencies/DaisySeedGFX2/cDisplay.cpp **** void cDisplay::Blend2Bloc( uint32_t OutputOffset, uint32_t  InputOffset1, uint32_t  InputOffset2, D
 487:dependencies/DaisySeedGFX2/cDisplay.cpp ****     
 488:dependencies/DaisySeedGFX2/cDisplay.cpp ****   // Loop through each pixels 
 489:dependencies/DaisySeedGFX2/cDisplay.cpp ****   for (uint16_t indexY = 0; indexY < Height; indexY++) {
 490:dependencies/DaisySeedGFX2/cDisplay.cpp ****     for (uint16_t indexX = 0; indexX < Width; indexX++) {
 491:dependencies/DaisySeedGFX2/cDisplay.cpp ****       // Check if the first source pixel has non-zero alpha
 492:dependencies/DaisySeedGFX2/cDisplay.cpp ****       if (pSource1->m_A != 0) {
 493:dependencies/DaisySeedGFX2/cDisplay.cpp ****         
 494:dependencies/DaisySeedGFX2/cDisplay.cpp ****         // If the alpha of the first source pixel is fully opaque
 495:dependencies/DaisySeedGFX2/cDisplay.cpp ****         if (pSource1->m_A == 255) {
 496:dependencies/DaisySeedGFX2/cDisplay.cpp ****           // Copy the RGB and alpha values from source1 directly to the destination
 497:dependencies/DaisySeedGFX2/cDisplay.cpp ****           pDest->m_R = pSource1->m_R;
 498:dependencies/DaisySeedGFX2/cDisplay.cpp ****           pDest->m_G = pSource1->m_G;
 499:dependencies/DaisySeedGFX2/cDisplay.cpp ****           pDest->m_B = pSource1->m_B;
 500:dependencies/DaisySeedGFX2/cDisplay.cpp ****           pDest->m_A = 255;
 501:dependencies/DaisySeedGFX2/cDisplay.cpp ****         
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccDJ0304.s 			page 31


 502:dependencies/DaisySeedGFX2/cDisplay.cpp ****         } else {
 503:dependencies/DaisySeedGFX2/cDisplay.cpp ****           // Perform alpha blending when the first source pixel is semi-transparent
 504:dependencies/DaisySeedGFX2/cDisplay.cpp ****           float alpha2 = pSource2->m_A / 255.0f; // Normalize alpha of source2
 505:dependencies/DaisySeedGFX2/cDisplay.cpp ****           float alpha1 = pSource1->m_A / 255.0f; // Normalize alpha of source1
 506:dependencies/DaisySeedGFX2/cDisplay.cpp ****           float outAlpha = alpha1 + alpha2 * (1 - alpha1); // Compute blended alpha
 507:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 508:dependencies/DaisySeedGFX2/cDisplay.cpp ****           // Compute the blended RGB values using the alpha values
 509:dependencies/DaisySeedGFX2/cDisplay.cpp ****           pDest->m_R = static_cast<uint8_t>((pSource1->m_R * alpha1 + pSource2->m_R * alpha2 * (1 -
 510:dependencies/DaisySeedGFX2/cDisplay.cpp ****           pDest->m_G = static_cast<uint8_t>((pSource1->m_G * alpha1 + pSource2->m_G * alpha2 * (1 -
 511:dependencies/DaisySeedGFX2/cDisplay.cpp ****           pDest->m_B = static_cast<uint8_t>((pSource1->m_B * alpha1 + pSource2->m_B * alpha2 * (1 -
 512:dependencies/DaisySeedGFX2/cDisplay.cpp ****           pDest->m_A = static_cast<uint8_t>(outAlpha * 255); // Convert alpha back to 0-255 range
 513:dependencies/DaisySeedGFX2/cDisplay.cpp ****         }
 514:dependencies/DaisySeedGFX2/cDisplay.cpp ****       }
 515:dependencies/DaisySeedGFX2/cDisplay.cpp ****       // Move to the next pixel in the row for both sources and the destination
 516:dependencies/DaisySeedGFX2/cDisplay.cpp ****       pSource1++;
 517:dependencies/DaisySeedGFX2/cDisplay.cpp ****       pSource2++;
 518:dependencies/DaisySeedGFX2/cDisplay.cpp ****       pDest++;
 519:dependencies/DaisySeedGFX2/cDisplay.cpp ****     }
 520:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Skip the padding at the end of each row for source1, source2, and destination
 521:dependencies/DaisySeedGFX2/cDisplay.cpp ****     pSource1 += InputOffset1;
 522:dependencies/DaisySeedGFX2/cDisplay.cpp ****     pSource2 += InputOffset2;
 523:dependencies/DaisySeedGFX2/cDisplay.cpp ****     pDest += OutputOffset;
 524:dependencies/DaisySeedGFX2/cDisplay.cpp ****   }   
 525:dependencies/DaisySeedGFX2/cDisplay.cpp **** }
