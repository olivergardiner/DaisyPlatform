 173:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 174:dependencies/DaisySeedGFX2/cDisplay.cpp **** // -----------------------------------------------------------------------------
 175:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Fill a rectangle with either a foreground or background color based on a bitmap
 176:dependencies/DaisySeedGFX2/cDisplay.cpp **** //
 177:dependencies/DaisySeedGFX2/cDisplay.cpp **** // This function fills a rectangle using a bitmap (1 bit per pixel, packed) to determine
 178:dependencies/DaisySeedGFX2/cDisplay.cpp **** // whether each pixel should take the foreground color (for bits set to 1) or the background
 179:dependencies/DaisySeedGFX2/cDisplay.cpp **** // color (for bits set to 0). It supports alpha blending for semi-transparent colors.
 180:dependencies/DaisySeedGFX2/cDisplay.cpp **** //
 181:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Parameters:
 182:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - x0, y0: Top-left corner of the rectangle.
ARM GAS  C:\Users\Oliver\AppData\Local\Temp\ccDJ0304.s 			page 22


 183:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - pBitmap: Pointer to the bitmap data (1 bit per pixel, packed).
 184:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - BitmapWidth, BitmapHeight: Dimensions of the bitmap in pixels.
 185:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - ForegroundColor: The color used for bits set to 1 in the bitmap.
 186:dependencies/DaisySeedGFX2/cDisplay.cpp **** // - BackgroundColor: The color used for bits set to 0 in the bitmap.
 187:dependencies/DaisySeedGFX2/cDisplay.cpp **** // -----------------------------------------------------------------------------
 188:dependencies/DaisySeedGFX2/cDisplay.cpp **** DAD_GFX_ERROR cLayer::fillRectWithBitmap(
 189:dependencies/DaisySeedGFX2/cDisplay.cpp ****     uint16_t x0, uint16_t y0, 
 190:dependencies/DaisySeedGFX2/cDisplay.cpp ****     const uint8_t* pBitmap, uint16_t BitmapWidth, uint16_t BitmapHeight,
 191:dependencies/DaisySeedGFX2/cDisplay.cpp ****     const sColor& ForegroundColor, const sColor& BackgroundColor) {
 192:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 193:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // -------------------------------------------------------------------------
 194:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Bounds check and framebuffer validation
 195:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if (x0 >= m_Width || y0 >= m_Height || !m_pLayerFrame) {
 196:dependencies/DaisySeedGFX2/cDisplay.cpp ****         return DAD_GFX_ERROR::Size_Error;  // Out of bounds or invalid framebuffer
 197:dependencies/DaisySeedGFX2/cDisplay.cpp ****     }
 198:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 199:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Adjust BitmapWidth and BitmapHeight to ensure they fit within the display
 200:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if (x0 + BitmapWidth > m_Width) {
 201:dependencies/DaisySeedGFX2/cDisplay.cpp ****         //BitmapWidth = m_Width - x0;
 202:dependencies/DaisySeedGFX2/cDisplay.cpp ****         return DAD_GFX_ERROR::Size_Error;  // Out of bounds 
 203:dependencies/DaisySeedGFX2/cDisplay.cpp ****     }
 204:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if (y0 + BitmapHeight > m_Height) {
 205:dependencies/DaisySeedGFX2/cDisplay.cpp ****         //BitmapHeight = m_Height - y0;
 206:dependencies/DaisySeedGFX2/cDisplay.cpp ****         return DAD_GFX_ERROR::Size_Error;  // Out of bounds 
 207:dependencies/DaisySeedGFX2/cDisplay.cpp ****     }
 208:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 209:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // -------------------------------------------------------------------------
 210:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Iterate through each row of the bitmap
 211:dependencies/DaisySeedGFX2/cDisplay.cpp ****     const uint8_t* pCurrentBitmap = pBitmap;  // Pointer to the current byte in the bitmap
 212:dependencies/DaisySeedGFX2/cDisplay.cpp ****     uint8_t currentByte = *pCurrentBitmap++;  // Load the first byte of the row
 213:dependencies/DaisySeedGFX2/cDisplay.cpp ****     uint8_t bitIndex = 0;  // Track the bit within the current byte
 214:dependencies/DaisySeedGFX2/cDisplay.cpp ****     
 215:dependencies/DaisySeedGFX2/cDisplay.cpp ****     for (uint16_t y = 0; y < BitmapHeight; ++y) {
 216:dependencies/DaisySeedGFX2/cDisplay.cpp ****         sColor* pFrame = &m_pLayerFrame[(y + y0) * m_Width + x0];  // Start of the row in the frame
 217:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 218:dependencies/DaisySeedGFX2/cDisplay.cpp ****         // Iterate through each column of the bitmap
 219:dependencies/DaisySeedGFX2/cDisplay.cpp ****         for (uint16_t x = 0; x < BitmapWidth; ++x) {
 220:dependencies/DaisySeedGFX2/cDisplay.cpp ****             // Determine the pixel color based on the current bitmap bit
 221:dependencies/DaisySeedGFX2/cDisplay.cpp ****             const sColor& Color = (currentByte & 0x80) ? ForegroundColor : BackgroundColor;
 222:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 223:dependencies/DaisySeedGFX2/cDisplay.cpp ****             // Apply the color with optional alpha blending
 224:dependencies/DaisySeedGFX2/cDisplay.cpp ****             if ((Color.m_A != 0) || (m_Mode == DRAW_MODE::Overwrite)) {  // Skip fully transparent 
 225:dependencies/DaisySeedGFX2/cDisplay.cpp ****                 if ((Color.m_A == 255) | (m_Mode == DRAW_MODE::Overwrite)) {
