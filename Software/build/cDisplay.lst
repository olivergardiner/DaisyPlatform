 434:dependencies/DaisySeedGFX2/cDisplay.cpp ****     setTFTRotation(r);  // Apply the rotation to the display hardware
 435:dependencies/DaisySeedGFX2/cDisplay.cpp ****     switch (r) {
 436:dependencies/DaisySeedGFX2/cDisplay.cpp ****     case Rotation::Degre_0:   // Portrait
 437:dependencies/DaisySeedGFX2/cDisplay.cpp ****     case Rotation::Degre_180: // Inverted portrait
 438:dependencies/DaisySeedGFX2/cDisplay.cpp ****         switchOrientation(ORIENTATION::Portrait);
 439:dependencies/DaisySeedGFX2/cDisplay.cpp ****         invalidateAll();  // Mark all blocks as dirty
 440:dependencies/DaisySeedGFX2/cDisplay.cpp ****         break;
 441:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 442:dependencies/DaisySeedGFX2/cDisplay.cpp ****     case Rotation::Degre_90:  // Landscape
 443:dependencies/DaisySeedGFX2/cDisplay.cpp ****     case Rotation::Degre_270: // Inverted landscape
 444:dependencies/DaisySeedGFX2/cDisplay.cpp ****         switchOrientation(ORIENTATION::Landscape);
