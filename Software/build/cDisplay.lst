 401:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Marks the corresponding dirty blocks for refresh
 402:dependencies/DaisySeedGFX2/cDisplay.cpp **** void cDisplay::invalidateRect(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1) {
 403:dependencies/DaisySeedGFX2/cDisplay.cpp ****     
 404:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Calculate the start and end column indices of the dirty blocks
 405:dependencies/DaisySeedGFX2/cDisplay.cpp ****     uint16_t startCol = x0 / m_DitryBlocWidth;
 406:dependencies/DaisySeedGFX2/cDisplay.cpp ****     uint16_t endCol = x1 / m_DitryBlocWidth;
 407:dependencies/DaisySeedGFX2/cDisplay.cpp ****     
 408:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Calculate the start and end row indices of the dirty blocks
 409:dependencies/DaisySeedGFX2/cDisplay.cpp ****     uint16_t startRow = y0 / m_DitryBlocHeight;
 410:dependencies/DaisySeedGFX2/cDisplay.cpp ****     uint16_t endRow = y1 / m_DitryBlocHeight;
 411:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 412:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Clamp the column indices to stay within the valid range
 413:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if (startCol >= m_NbDitryBlocX) startCol = m_NbDitryBlocX - 1;
 414:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if (endCol >= m_NbDitryBlocX) endCol = m_NbDitryBlocX - 1;
 415:dependencies/DaisySeedGFX2/cDisplay.cpp ****     
 416:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Clamp the row indices to stay within the valid range
 417:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if (startRow >= m_NbDitryBlocY) startRow = m_NbDitryBlocY - 1;
 418:dependencies/DaisySeedGFX2/cDisplay.cpp ****     if (endRow >= m_NbDitryBlocY) endRow = m_NbDitryBlocY - 1;
 419:dependencies/DaisySeedGFX2/cDisplay.cpp **** 
 420:dependencies/DaisySeedGFX2/cDisplay.cpp ****     // Mark all blocks overlapping the rectangle as dirty
 421:dependencies/DaisySeedGFX2/cDisplay.cpp ****     for (uint16_t row = startRow; row <= endRow; ++row) {
 422:dependencies/DaisySeedGFX2/cDisplay.cpp ****         for (uint16_t col = startCol; col <= endCol; ++col) {
 423:dependencies/DaisySeedGFX2/cDisplay.cpp ****             m_DirtyBlocks[row][col] = 1;
 424:dependencies/DaisySeedGFX2/cDisplay.cpp ****         }
 425:dependencies/DaisySeedGFX2/cDisplay.cpp ****     }
 426:dependencies/DaisySeedGFX2/cDisplay.cpp **** }
