  13:dependencies/DaisySeedGFX2/TFT_SPI.h **** // TFT Generic commands
  14:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_NOP     0x00    // No operation
  15:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_SWRST   0x01    // Software reset
  16:dependencies/DaisySeedGFX2/TFT_SPI.h **** 
  17:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_INVOFF  0x20    // Disable inversion
  18:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_INVON   0x21    // Enable inversion
  19:dependencies/DaisySeedGFX2/TFT_SPI.h **** 
  20:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_DISPOFF 0x28    // Turn display off
  21:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_DISPON  0x29    // Turn display on
  22:dependencies/DaisySeedGFX2/TFT_SPI.h **** 
  23:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_CASET   0x2A    // Set column address
  24:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_RASET   0x2B    // Set row address
  25:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_RAMWR   0x2C    // Write to display RAM
  26:dependencies/DaisySeedGFX2/TFT_SPI.h **** 
  27:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_MADCTL  0x36    // Memory access control
  28:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_MAD_MY  0x80    // Row address order
  29:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_MAD_MX  0x40    // Column address order
  30:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_MAD_MV  0x20    // Row/Column exchange
  31:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_MAD_ML  0x10    // Vertical refresh order
  32:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_MAD_BGR 0x08    // Blue-Green-Red pixel order
  33:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_MAD_MH  0x04    // Horizontal refresh order
  34:dependencies/DaisySeedGFX2/TFT_SPI.h **** #define TFT_MAD_RGB 0x00    // Red-Green-Blue pixel order
  35:dependencies/DaisySeedGFX2/TFT_SPI.h **** 
