 301:dependencies/DaisySeedGFX2/cDisplay.h ****         }
 302:dependencies/DaisySeedGFX2/cDisplay.h ****         return true;  // FIFO is not full
 303:dependencies/DaisySeedGFX2/cDisplay.h ****     }
