 104:dependencies/DaisySeedGFX2/cDisplay.h **** class Cmd_RASET {
 105:dependencies/DaisySeedGFX2/cDisplay.h **** public:
 106:dependencies/DaisySeedGFX2/cDisplay.h ****     friend class cDisplay;
 107:dependencies/DaisySeedGFX2/cDisplay.h **** 
 108:dependencies/DaisySeedGFX2/cDisplay.h ****     // --------------------------------------------------------------------------
 109:dependencies/DaisySeedGFX2/cDisplay.h ****     // Constructor
 110:dependencies/DaisySeedGFX2/cDisplay.h ****     Cmd_RASET() {
 111:dependencies/DaisySeedGFX2/cDisplay.h ****         m_Commande = TFT_RASET;  // Initialize with the TFT_RASET command
 112:dependencies/DaisySeedGFX2/cDisplay.h ****     }
 113:dependencies/DaisySeedGFX2/cDisplay.h **** 
 114:dependencies/DaisySeedGFX2/cDisplay.h ****     // --------------------------------------------------------------------------
 115:dependencies/DaisySeedGFX2/cDisplay.h ****     // Define the vertical window (row range)
 116:dependencies/DaisySeedGFX2/cDisplay.h ****     void setData(uint16_t y, uint16_t dy) {
 117:dependencies/DaisySeedGFX2/cDisplay.h ****         #if YSCREEN_OFFSET != 0
 118:dependencies/DaisySeedGFX2/cDisplay.h ****         y += YSCREEN_OFFSET;
 119:dependencies/DaisySeedGFX2/cDisplay.h ****         dy += YSCREEN_OFFSET;
 120:dependencies/DaisySeedGFX2/cDisplay.h ****         #endif
 121:dependencies/DaisySeedGFX2/cDisplay.h ****         m_Data[0] = y >> 8;       // High byte of the starting row
 122:dependencies/DaisySeedGFX2/cDisplay.h ****         m_Data[1] = y & 0xFF;     // Low byte of the starting row
 123:dependencies/DaisySeedGFX2/cDisplay.h ****         m_Data[2] = dy >> 8;      // High byte of the ending row
 124:dependencies/DaisySeedGFX2/cDisplay.h ****         m_Data[3] = dy & 0xFF;    // Low byte of the ending row
 125:dependencies/DaisySeedGFX2/cDisplay.h ****     }
 126:dependencies/DaisySeedGFX2/cDisplay.h **** 
 127:dependencies/DaisySeedGFX2/cDisplay.h ****     // --------------------------------------------------------------------------
 128:dependencies/DaisySeedGFX2/cDisplay.h ****     // Class data
 129:dependencies/DaisySeedGFX2/cDisplay.h **** protected:
 130:dependencies/DaisySeedGFX2/cDisplay.h ****     uint8_t m_Commande;  // SPI command identifier
 131:dependencies/DaisySeedGFX2/cDisplay.h ****     uint8_t m_Data[4];   // Command data for the row range
 132:dependencies/DaisySeedGFX2/cDisplay.h **** };
