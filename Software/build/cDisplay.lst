 445:dependencies/DaisySeedGFX2/cDisplay.cpp ****         invalidateAll();  // Mark all blocks as dirty
 446:dependencies/DaisySeedGFX2/cDisplay.cpp ****         break;
 447:dependencies/DaisySeedGFX2/cDisplay.cpp ****     }
 448:dependencies/DaisySeedGFX2/cDisplay.cpp **** }
