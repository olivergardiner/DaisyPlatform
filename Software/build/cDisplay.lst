 295:dependencies/DaisySeedGFX2/cDisplay.h ****     // Check if the FIFO buffer is full
 296:dependencies/DaisySeedGFX2/cDisplay.h ****     // Returns true if the FIFO buffer can accept more blocks
 297:dependencies/DaisySeedGFX2/cDisplay.h ****     inline bool isFull() {
 298:dependencies/DaisySeedGFX2/cDisplay.h ****         // Protect m_FIFO_NbElements to avoid race conditions
 299:dependencies/DaisySeedGFX2/cDisplay.h ****         if (m_FIFO_NbElements >= SIZE_FIFO) {
