 429:dependencies/DaisySeedGFX2/cDisplay.cpp **** // Set the screen's rotation 
 430:dependencies/DaisySeedGFX2/cDisplay.cpp **** void cDisplay::setOrientation(Rotation r) {
 431:dependencies/DaisySeedGFX2/cDisplay.cpp ****     while (m_Busy == true) {
 432:dependencies/DaisySeedGFX2/cDisplay.cpp ****         Delay(1);  // Wait until the display is no longer busy
