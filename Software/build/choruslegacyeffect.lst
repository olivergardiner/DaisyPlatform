  32:effects/choruslegacyeffect.cpp ****     if (!enabled_) {
  33:effects/choruslegacyeffect.cpp ****         // Bypass - pass through dry signal
  34:effects/choruslegacyeffect.cpp ****         for (size_t i = 0; i < size; i++) {
  35:effects/choruslegacyeffect.cpp ****             out[i] = in[i];
  36:effects/choruslegacyeffect.cpp ****         }
