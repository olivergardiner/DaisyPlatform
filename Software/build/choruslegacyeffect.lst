  39:effects/choruslegacyeffect.cpp ****     
  40:effects/choruslegacyeffect.cpp ****     // Get mix parameter (index 0)
  41:effects/choruslegacyeffect.cpp ****     float mix = parameters_.size() > 0 ? parameters_[0]->GetValue() : 0.5f;
  42:effects/choruslegacyeffect.cpp ****     
  43:effects/choruslegacyeffect.cpp ****     // Process with wet/dry blend
  44:effects/choruslegacyeffect.cpp ****     for (size_t i = 0; i < size; i++) {
  45:effects/choruslegacyeffect.cpp ****         float wet = chorusL_.Process(in[i]);
  46:effects/choruslegacyeffect.cpp ****         out[i] = in[i] * (1.0f - mix) + wet * mix;
  47:effects/choruslegacyeffect.cpp ****     }
  48:effects/choruslegacyeffect.cpp **** }
